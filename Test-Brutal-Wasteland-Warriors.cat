<?xml version='1.0' encoding='utf-8'?>
<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema" library="false" id="88b5-507d-3703-4492" name="Brutal - Wasteland Warriors" gameSystemId="sys-e140-121e-9b34-0be3" gameSystemRevision="13" revision="13" battleScribeVersion="2.03" type="catalogue" authorName="TRIBAL 2nd Edition rules by Mana Press. NR data authored privately for personal use.">
  <sharedSelectionEntries>
    <selectionEntry type="upgrade" name="Adept (Veteran Skill)" hidden="false" id="677a-34d7-785a-f517" import="true">
      <rules>
        <rule id="e1b6-2c05-bca4-bc7c" name="Adept" hidden="false">
          <description>After long training with their weapon of choice, this Unit has a Preferred Weapon Bonus of +2 instead of the normal +1. Cannot be combined with Champion or Duellist.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="eb26-c659-615f-4c05" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Agile (Veteran Skill)" hidden="false" id="6787-2ada-1c28-4a3f" import="true">
      <rules>
        <rule id="301e-a6a3-f455-3de6" name="Agile" hidden="false">
          <description>The Unit always begins a combat round with Advantage, even if Charged. If both Units engaged in combat have this Skill, the Unit that made the Charge starts with Advantage as normal.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="d995-c4ee-44de-f792" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Cunning (Veteran Skill)" hidden="false" id="a1d5-1a2e-329e-8823" import="true">
      <rules>
        <rule id="e026-059d-6293-35d7" name="Cunning" hidden="false">
          <description>This Unit adds +1 to its card value on any red (Hearts or Diamonds) Feint card played during an Exchange.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="46dd-d770-b74d-18bc" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Deadly Shot (Veteran Skill)" hidden="false" id="2825-b49c-809e-f27a" import="true">
      <rules>
        <rule id="4ed9-54d4-a477-acf3" name="Deadly Shot" hidden="false">
          <description>This Unit adds +2 to its card value when making ranged attacks. Normally only useful for Marksmen, or Characters with the Long Shot Skill.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="64f2-6c21-bb1b-756b" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Duellist (Veteran Skill)" hidden="false" id="fdbb-5dc0-28b2-ea59" import="true">
      <rules>
        <rule id="07cf-676a-5c33-b7b9" name="Duellist" hidden="false">
          <description>Characters only. Gains the Preferred Weapon Bonus from both Spade and Club Strike cards. Cannot be combined with Adept or Champion.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="be6f-e9a6-3261-36d1" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Elite Marksmen (Veteran Skill)" hidden="false" id="18f3-d3f2-db79-5b0d" import="true">
      <rules>
        <rule id="8869-6df7-9d25-a287" name="Elite Marksmen" hidden="false">
          <description>Marksmen only. This Unit is considered armed with either short or long weapons, and fights in combat as if it were Warriors.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="c5ae-6996-f3c2-0490" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Fearsome (Veteran Skill)" hidden="false" id="0c13-55c8-f58c-ffc4" import="true">
      <rules>
        <rule id="265e-8cfc-70bb-8513" name="Fearsome" hidden="false">
          <description>This Unit causes +1 hit with Spade or Club Strike cards when it wins an Exchange against a Formation.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="34e4-933c-43ff-9107" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Hard Target (Veteran Skill)" hidden="false" id="155f-b51a-ae0e-ed33" import="true">
      <rules>
        <rule id="f749-9773-316c-cbad" name="Hard Target" hidden="false">
          <description>Marksmen firing at this Unit suffer -2 to their attack card value.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="a0ed-2b9e-2c96-aefa" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Long Shot (Veteran Skill)" hidden="false" id="266c-524a-d3f0-e67e" import="true">
      <rules>
        <rule id="995a-c193-659c-50a7" name="Long Shot" hidden="false">
          <description>Characters only. This Character may use its Activation Card to make a ranged attack, resolved as a ranged attack from a Unit of Marksmen. Unlike Marksmen, if the target Unit is destroyed this way the player DOES receive Blood Payment.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="7f76-d254-a08b-c5f7" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Ranger (Veteran Skill)" hidden="false" id="781c-1d7f-65d2-6feb" import="true">
      <rules>
        <rule id="4b7f-5448-cbba-0fab" name="Ranger" hidden="false">
          <description>This Unit is not slowed to a Walk when moving through Tough Going, and may Walk (1 short card-edge) across Impassable terrain if it can clear it in a single activation. Cannot be used by Cavalry.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="ea05-c982-db9f-782a" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Savage (Veteran Skill)" hidden="false" id="fe06-eede-e3cd-ed05" import="true">
      <rules>
        <rule id="e1be-07c7-a649-9498" name="Savage" hidden="false">
          <description>This Unit causes +1 hit with Spade or Club Strike cards when it wins an Exchange against a Character.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="be60-aabe-ac0c-496c" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Survival Instinct (Veteran Skill)" hidden="false" id="b823-f894-16d1-3fba" import="true">
      <rules>
        <rule id="d814-065c-856f-4c1b" name="Survival Instinct" hidden="false">
          <description>After winning an Exchange, this Unit may break off from combat instead of causing damage: it discards its remaining combat-hand cards and an equal number of the enemy's. The Unit still counts as having lost the combat round (it retreats and the enemy gains the reward).</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="ef55-0881-f2db-c060" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Tactician (Veteran Skill)" hidden="false" id="5986-1616-c450-ed29" import="true">
      <rules>
        <rule id="7167-9708-f5a4-7301" name="Tactician" hidden="false">
          <description>Warlord only. Immediately after the setup phase, the player may reposition 1 enemy Hero or Formation anywhere within the opponent's setup zone.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="4a93-72cc-fbcf-baa9" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Throwing Weapons (Veteran Skill)" hidden="false" id="f90e-932b-8b79-733c" import="true">
      <rules>
        <rule id="5baf-c79f-43ae-6cad" name="Throwing Weapons" hidden="false">
          <description>When this Unit Charges into close combat, flip a card: a black (Spade or Club) card causes 1 hit on the target before the Charge is resolved. Not increased by Strong.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="f12c-115d-3215-bdf3" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Tough (Veteran Skill)" hidden="false" id="d225-12f6-87ed-9d59" import="true">
      <rules>
        <rule id="6b31-f1eb-e86f-1b97" name="Tough" hidden="false">
          <description>Characters only. This Character begins the game with +1 Wound. This extra Wound does not increase its combat hand size.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="acdc-8f8b-49a2-603a" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Respected (Veteran Skill)" hidden="false" id="acd1-9dd3-641c-7b2c" import="true">
      <rules>
        <rule id="95b8-719d-64bd-0dee" name="Respected" hidden="false">
          <description>Warlord only. Card Pools optional rule only. At the start of the game, this Warlord's player draws 1 additional Card Pool card (6 total). Not lost if the Warlord is slain. Cannot be combined with Revered.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="98c8-5987-6e39-9720" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Berserker (Elite Skill)" hidden="false" id="155c-166e-3ecf-83a1" import="true">
      <rules>
        <rule id="d356-1dfa-ab6e-2881" name="Berserker" hidden="false">
          <description>Characters only. This Character always draws its combat hand as if completely unwounded. It suffers -2 to the value of any red (Hearts or Diamonds) Feint card it plays.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="e0fd-6a7a-9e43-b00a" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="2" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Champion (Elite Skill)" hidden="false" id="3e0d-f2ae-832f-22c3" import="true">
      <rules>
        <rule id="3d19-a5ee-61f7-998e" name="Champion" hidden="false">
          <description>Characters only. Preferred Weapon Bonus of +2 (instead of +1), plus a further +1 Preferred Weapon Bonus with the other Strike suit. Cannot be combined with Adept or Duellist.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="c189-305f-2c5b-d0d1" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="2" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Concealment (Elite Skill)" hidden="false" id="16ba-a367-0612-8f59" import="true">
      <rules>
        <rule id="ad6e-933d-183b-115c" name="Concealment" hidden="false">
          <description>Warlord only. During deployment, this player's Units are represented by red (Hearts/Diamonds) cards placed face down: number cards for Formations, face cards for Characters, plus an equal number of black decoy cards. All are revealed and Units placed before the first turn.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="116b-ac09-0560-b266" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="2" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Seasoned (Elite Skill)" hidden="false" id="50f7-753e-3747-2263" import="true">
      <rules>
        <rule id="781d-6ff7-22fb-920a" name="Seasoned" hidden="false">
          <description>This Unit may discard and redraw 2 cards from its combat hand before the first Exchange of a combat.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="318e-f8d2-14ba-f75a" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="2" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Strong (Elite Skill)" hidden="false" id="e1ee-a160-d5f4-35f4" import="true">
      <rules>
        <rule id="7e37-c5e0-0c3f-9f58" name="Strong" hidden="false">
          <description>Characters only. This Character causes +1 hit when it wins a hand-to-hand Exchange with a Spade or Club Strike card.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="7342-fb3e-c572-02b1" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="2" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Revered (Elite Skill)" hidden="false" id="6b60-a2c7-e386-c2a1" import="true">
      <rules>
        <rule id="e619-31c5-f59f-5480" name="Revered" hidden="false">
          <description>Warlord only. Card Pools optional rule only. At the start of the game, this Warlord's player draws 2 additional Card Pool cards (7 total). Not lost if the Warlord is slain. Cannot be combined with Respected.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="5500-1d50-c4ec-1abf" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="2" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Ammo Stash (Veteran Skill)" hidden="false" id="ca32-0d06-c217-a3b5" import="true">
      <rules>
        <rule id="1320-570c-2486-aecd" name="Ammo Stash" hidden="false">
          <description>Characters only. After a lucky find the Character never runs out of ammo, but must still reload as normal.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="3503-437b-d17d-a819" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Short Weapon" hidden="false" id="e568-7284-2756-1a9e" import="true">
      <rules>
        <rule id="b406-ee23-f0c8-d99c" name="Short Weapon" hidden="false">
          <description>Sword, axe, knife, club or similar. Gives the Preferred Weapon Bonus on Club Strike cards.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="0" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Long Weapon" hidden="false" id="d987-37e4-d5fc-30fb" import="true">
      <rules>
        <rule id="695a-e482-40c6-e656" name="Long Weapon" hidden="false">
          <description>Spear, long-axe, pike, polearm or similar. Gives the Preferred Weapon Bonus on Spade Strike cards.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="0" />
      </costs>
    </selectionEntry>
    <selectionEntry type="model" name="Chief - The Warlord" hidden="false" id="ceec-ceb0-8cfb-9169" import="true">
      <categoryLinks>
        <categoryLink id="cf5c-597d-75b2-01a1" name="Warlord" hidden="false" targetId="21fb-7998-9dc4-5fd0" primary="true" />
      </categoryLinks>
      <profiles>
        <profile name="Chief - The Warlord" hidden="false" typeId="49d0-84ee-492f-492f" typeName="Unit" id="7a80-37dd-cb27-e657">
          <characteristics>
            <characteristic name="Wounds" typeId="aea1-39b1-ec9b-475a">6</characteristic>
            <characteristic name="Skills" typeId="1200-2470-7a16-e426">0-3</characteristic>
            <characteristic name="Notes" typeId="fb14-0b46-30b6-76a9">Always fights and moves alone; never joins Heroes or Formations. Combat hand = 1 card per remaining Wound. Free bonus: 1 free Elite Skill for any 1 Unit in the warband (including itself), OR 1 free Veteran Skill for each of 2 Units -- apply this as a discount when you spend Honour on Skills.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink id="5e2b-34ff-c1c3-e719" name="Wasteland Weapons" hidden="false" targetId="4fd7-4bda-25bb-9e42" type="rule" />
        <infoLink id="575b-dcb4-cf88-135a" name="Wasteland Firearms" hidden="false" targetId="42bb-f549-c138-0d21" type="rule" />
        <infoLink id="358e-4a4e-08a3-94af" name="Toughs" hidden="false" targetId="126b-2766-9bf4-e432" type="rule" />
      </infoLinks>
      <selectionEntryGroups>
        <selectionEntryGroup name="Weapon (choose 1)" hidden="false" id="3054-023f-4e91-3e8a" defaultSelectionEntryId="650b-c380-58bf-c30d">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="7228-ea73-6834-8d4a" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="9537-e8e1-7e17-0f06" />
          </constraints>
          <entryLinks>
            <entryLink name="Short Weapon" hidden="false" id="650b-c380-58bf-c30d" type="selectionEntry" targetId="e568-7284-2756-1a9e" import="true" />
            <entryLink name="Long Weapon" hidden="false" id="4bdc-a1c9-bcf4-5dd0" type="selectionEntry" targetId="d987-37e4-d5fc-30fb" import="true" />
          </entryLinks>
        </selectionEntryGroup>
        <selectionEntryGroup name="Skills (choose up to 3)" hidden="false" id="82ce-39c4-0c77-7a8e">
          <constraints>
            <constraint type="max" value="3" field="selections" scope="parent" shared="true" id="5b03-0b32-484c-c689" />
          </constraints>
          <selectionEntryGroups>
            <selectionEntryGroup name="Weapon Mastery Skill (choose up to 1: Adept, Duellist or Champion)" hidden="false" id="6753-f5e3-9dd3-e1be">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="d349-42cc-0811-651c" />
              </constraints>
              <entryLinks>
                <entryLink name="Adept (Veteran Skill)" hidden="false" id="d886-d6e8-23e3-accd" type="selectionEntry" targetId="677a-34d7-785a-f517" import="true" />
                <entryLink name="Duellist (Veteran Skill)" hidden="false" id="87ee-0b83-3dde-b1a7" type="selectionEntry" targetId="fdbb-5dc0-28b2-ea59" import="true" />
                <entryLink name="Champion (Elite Skill)" hidden="false" id="14b1-375b-5e5b-2759" type="selectionEntry" targetId="3e0d-f2ae-832f-22c3" import="true" />
              </entryLinks>
            </selectionEntryGroup>
            <selectionEntryGroup name="Card Pool Bonus Skill (choose up to 1: Respected or Revered; Card Pools option only)" hidden="false" id="1080-856a-26aa-c1b5">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="8dd4-533d-a1cc-3a43" />
              </constraints>
              <entryLinks>
                <entryLink name="Respected (Veteran Skill)" hidden="false" id="9ab0-59cd-0864-d950" type="selectionEntry" targetId="acd1-9dd3-641c-7b2c" import="true" />
                <entryLink name="Revered (Elite Skill)" hidden="false" id="7f82-eb03-cce3-0213" type="selectionEntry" targetId="6b60-a2c7-e386-c2a1" import="true" />
              </entryLinks>
            </selectionEntryGroup>
          </selectionEntryGroups>
          <entryLinks>
            <entryLink name="Agile (Veteran Skill)" hidden="false" id="36bf-c6b5-c13f-f3be" type="selectionEntry" targetId="6787-2ada-1c28-4a3f" import="true" />
            <entryLink name="Cunning (Veteran Skill)" hidden="false" id="e4f1-dd50-bc7c-2d7e" type="selectionEntry" targetId="a1d5-1a2e-329e-8823" import="true" />
            <entryLink name="Deadly Shot (Veteran Skill)" hidden="false" id="ad0a-f986-3c01-9443" type="selectionEntry" targetId="2825-b49c-809e-f27a" import="true" />
