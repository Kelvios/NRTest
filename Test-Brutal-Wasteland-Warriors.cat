    <selectionEntry type="upgrade" name="Home-made Flintlock Pistol" hidden="false" id="f59a-b554-6bc9-85d5" import="true">
      <rules>
        <rule id="0b05-dd59-8c2c-9ab9" name="Home-made Flintlock Pistol" hidden="false">
          <description>Costs the warband 1 Honour. Chief or Hero. Range 2 long card-edges, 1 shot per activation, then must reload.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Sawn-off Shotgun" hidden="false" id="9b1b-a84e-813c-1add" import="true">
      <rules>
        <rule id="86a9-8cd9-7672-5289" name="Sawn-off Shotgun" hidden="false">
          <description>Costs the warband 1 Honour. Chief only. Range 2 long card-edges, extra +1 to hit; an Ace or Joker that hits does 2 hits, a 2 or 3 has a misfire risk (see the rulebook).</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Modern Pistol" hidden="false" id="b0f7-ca05-a090-7698" import="true">
      <rules>
        <rule id="9251-4c73-b343-087a" name="Modern Pistol" hidden="false">
          <description>Costs the warband 2 Honour. Chief only. No range limit, 1 to 3 shots, reload only on a 2 or 3.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="2" />
      </costs>
    </selectionEntry>
  </sharedSelectionEntries>
  <sharedRules>
    <rule id="4fd7-4bda-25bb-9e42" name="Wasteland Weapons" hidden="false">
      <description>A post-apocalyptic gang has access to long weapons: use the standard long and short weapon types, including Missile Troops. Firearms are rare.</description>
    </rule>
    <rule id="42bb-f549-c138-0d21" name="Wasteland Firearms" hidden="false">
      <description>Standard firearm rules with changes: a firearm affords no Honour but costs the warband Honour (flintlock or sawn-off 1, modern pistol 2). Heroes may only have home-made flintlock pistols; only the Chief may carry a sawn-off or modern pistol. Firing costs no Honour, and destroying a unit with firearms does give Honour.</description>
    </rule>
    <rule id="126b-2766-9bf4-e432" name="Toughs" hidden="false">
      <description>Toughs are the TRIBAL Warriors under another name: they share all the usual rules, costs and Skills.</description>
    </rule>
  </sharedRules>
