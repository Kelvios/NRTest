    <selectionEntry type="upgrade" name="Supra Numerum Leader (Support)" hidden="false" id="c9d5-fbfd-0bfe-7183" import="true">
      <categoryLinks>
        <categoryLink id="8c2c-de6a-4cb6-80ec" name="Support" hidden="false" targetId="593d-f6c4-10ed-66df" primary="true" />
      </categoryLinks>
      <rules>
        <rule id="1024-b616-a26a-e876" name="Supra Numerum Leader (Support)" hidden="false">
          <description>List One. A leader who is not on the table and has no command initiatives. Only Status I, Status II and Supra Numerum leaders may be chosen as support.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Support" typeId="7c9a-b7c3-373d-72a6" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Gallic Stewards" hidden="false" id="0e43-85b9-12dc-395b" import="true">
      <categoryLinks>
        <categoryLink id="b208-8c21-be49-3099" name="Support" hidden="false" targetId="593d-f6c4-10ed-66df" primary="true" />
      </categoryLinks>
      <rules>
        <rule id="740b-8521-d01f-16e2" name="Gallic Stewards" hidden="false">
          <description>List One. A base of Stewards. One base is always present with mounted Gallic Noble Cavalry; extra bases up to the number of Noble Cavalry Groups may be chosen. This is not enforced here: check the count yourself.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Support" typeId="7c9a-b7c3-373d-72a6" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Wagon" hidden="false" id="e266-8e04-20ff-81ef" import="true">
      <categoryLinks>
        <categoryLink id="81ac-176a-2b1a-347f" name="Support" hidden="false" targetId="593d-f6c4-10ed-66df" primary="true" />
      </categoryLinks>
      <rules>
        <rule id="9820-bec9-2155-e3ce" name="Wagon" hidden="false">
          <description>List Two. Limited supplies; Groups out of ammunition can resupply from it. Maximum two.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="2" field="selections" scope="roster" shared="true" id="946e-316a-1a54-9fc3" />
      </constraints>
      <costs>
        <cost name="Support" typeId="7c9a-b7c3-373d-72a6" value="2" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Musician" hidden="false" id="2796-a44c-895d-e05f" import="true">
      <categoryLinks>
        <categoryLink id="4efe-681f-6a45-bc7f" name="Support" hidden="false" targetId="593d-f6c4-10ed-66df" primary="true" />
      </categoryLinks>
      <rules>
        <rule id="91e6-0b31-0fbd-18f9" name="Musician" hidden="false">
          <description>List Two. Attached to the force commander to double his Command Range. Maximum one.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="aefa-e71a-469d-da6a" />
      </constraints>
      <costs>
        <cost name="Support" typeId="7c9a-b7c3-373d-72a6" value="2" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Faggots" hidden="false" id="7f4f-7adc-cc40-d12a" import="true">
      <categoryLinks>
        <categoryLink id="2501-ccb5-adb1-39c7" name="Support" hidden="false" targetId="593d-f6c4-10ed-66df" primary="true" />
      </categoryLinks>
      <rules>
        <rule id="87e4-9df1-41bd-5af6" name="Faggots" hidden="false">
          <description>List Two. One bundle of Faggots; any number may be chosen. See the rulebook (page 70).</description>
        </rule>
      </rules>
      <costs>
        <cost name="Support" typeId="7c9a-b7c3-373d-72a6" value="2" />
      </costs>
    </selectionEntry>
