      </categoryLinks>
      <rules>
        <rule id="67f7-d2de-a8b3-9a62" name="Fortified Wall" hidden="false">
          <description>List Twenty. A wall combined with a palisade: one 12 inch section within 12 inches of the Deployment Zone or friendly Ambush Points. Maximum one.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="ef59-be51-3d90-dbb1" />
      </constraints>
      <costs>
        <cost name="Support" typeId="7c9a-b7c3-373d-72a6" value="20" />
      </costs>
    </selectionEntry>
