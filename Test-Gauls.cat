    <selectionEntry type="upgrade" name="Palisade" hidden="false" id="cda3-acae-96df-5182" import="true">
      <categoryLinks>
        <categoryLink id="f08e-7ca0-a76a-c14c" name="Support" hidden="false" targetId="593d-f6c4-10ed-66df" primary="true" />
      </categoryLinks>
      <rules>
        <rule id="672c-3a8e-985f-15c0" name="Palisade" hidden="false">
          <description>List Twelve. One 12 inch section of palisade within 12 inches of the Deployment Zone or friendly Ambush Points. Up to two may be chosen.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="2" field="selections" scope="roster" shared="true" id="9bbb-79ed-4440-7578" />
      </constraints>
      <costs>
        <cost name="Support" typeId="7c9a-b7c3-373d-72a6" value="12" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Fortified Wall" hidden="false" id="7114-3122-eb26-72dd" import="true">
