<?xml version='1.0' encoding='utf-8'?>
<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema" library="false" id="a0ce-6a56-4479-a891" name="Primeval - Cro-Magnons: The Wolf" gameSystemId="sys-e140-121e-9b34-0be3" gameSystemRevision="13" revision="13" battleScribeVersion="2.03" type="catalogue" authorName="TRIBAL 2nd Edition rules by Mana Press. NR data authored privately for personal use.">
  <sharedSelectionEntries>
    <selectionEntry type="upgrade" name="Agile (Veteran Skill)" hidden="false" id="c0a0-2751-b51b-c0a9" import="true">
      <rules>
        <rule id="803e-69f2-b4cc-2919" name="Agile" hidden="false">
          <description>The Unit always begins a combat round with Advantage, even if Charged. If both Units engaged in combat have this Skill, the Unit that made the Charge starts with Advantage as normal.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="2358-51f4-162a-d189" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Adept [Skilled, long weapons only] (Veteran Skill)" hidden="false" id="d10b-9544-88c2-c430" import="true">
      <rules>
        <rule id="1af5-531d-e6dc-9b53" name="Adept" hidden="false">
          <description>After long training with their weapon of choice, this Unit has a Preferred Weapon Bonus of +2 instead of the normal +1. Cannot be combined with Champion or Duellist. Long weapons only (not enforced here).</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="d382-f26c-1f9a-ad0b" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Throwing Weapons (Veteran Skill)" hidden="false" id="d5dc-1f8b-ddaa-f0e0" import="true">
      <rules>
        <rule id="5ef6-8e70-b872-bf18" name="Throwing Weapons" hidden="false">
          <description>When this Unit Charges into close combat, flip a card: a black (Spade or Club) card causes 1 hit on the target before the Charge is resolved. Not increased by Strong.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="fa17-e6a6-6c45-a20a" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Skin-Changer (Veteran Skill)" hidden="false" id="f512-5606-4bf4-a40a" import="true">
      <rules>
        <rule id="50a1-e25b-06af-21da" name="Skin-Changer" hidden="false">
          <description>Characters only. If a wounded Skin-Changer wins an Exchange with a Panic! card, it is resolved with full combat effect.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="ebeb-352b-16bc-bf14" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Seasoned (Elite Skill)" hidden="false" id="e085-bd3b-6516-ad09" import="true">
      <rules>
        <rule id="559b-ec8b-2ece-0a76" name="Seasoned" hidden="false">
          <description>This Unit may discard and redraw 2 cards from its combat hand before the first Exchange of a combat.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="5c65-0adc-4c7a-cd49" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="2" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Lone Hunter (Veteran Skill)" hidden="false" id="3a21-701f-f1a0-4d63" import="true">
      <rules>
        <rule id="f1c7-c411-ea07-da9d" name="Lone Hunter" hidden="false">
          <description>Heroes only. This Hero fires a missile weapon exactly like a unit of Archers, but has no short or long weapon in combat. Any unit it destroys gives the warband no Honour: the Honour goes back to the central supply instead of to the opponent.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="0261-1f7c-ed9b-341e" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Cunning (Veteran Skill)" hidden="false" id="48e1-23fb-f183-7361" import="true">
      <rules>
        <rule id="048b-2742-508e-8670" name="Cunning" hidden="false">
          <description>This Unit adds +1 to its card value on any red (Hearts or Diamonds) Feint card played during an Exchange.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="d8cb-ad6b-cabc-3bde" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Tactician (Veteran Skill)" hidden="false" id="3d18-9501-6e06-6487" import="true">
      <rules>
        <rule id="a6a9-0fa1-8a32-6ed2" name="Tactician" hidden="false">
          <description>Warlord only. Immediately after the setup phase, the player may reposition 1 enemy Hero or Formation anywhere within the opponent's setup zone.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="39d2-d355-1834-c0f5" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Short Weapon" hidden="false" id="c94c-e905-be4f-dcd5" import="true">
      <rules>
        <rule id="2b1c-e7e0-2fba-07c4" name="Short Weapon" hidden="false">
          <description>Sword, axe, knife, club or similar. Gives the Preferred Weapon Bonus on Club Strike cards.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="0" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Long Weapon" hidden="false" id="4f49-598f-2abb-4b64" import="true">
      <rules>
        <rule id="797a-4b93-db0b-84e7" name="Long Weapon" hidden="false">
          <description>Spear, long-axe, pike, polearm or similar. Gives the Preferred Weapon Bonus on Spade Strike cards.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="0" />
      </costs>
    </selectionEntry>
    <selectionEntry type="model" name="Chief (Warlord)" hidden="false" id="f4c3-8c9b-5248-64a7" import="true">
      <categoryLinks>
        <categoryLink id="6a1e-399d-fe5a-e9ce" name="Warlord" hidden="false" targetId="21fb-7998-9dc4-5fd0" primary="true" />
