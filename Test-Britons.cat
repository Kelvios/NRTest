    <selectionEntry type="upgrade" name="Supra Numerum Leader (Support)" hidden="false" id="49a8-4855-b439-663f" import="true">
      <categoryLinks>
        <categoryLink id="d190-b159-3f10-d771" name="Support" hidden="false" targetId="593d-f6c4-10ed-66df" primary="true" />
      </categoryLinks>
      <rules>
        <rule id="a6d3-5735-cf83-27ba" name="Supra Numerum Leader (Support)" hidden="false">
          <description>List One. A leader who is not on the table and has no command initiatives. Only Status I, Status II and Supra Numerum leaders may be chosen as support.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Support" typeId="7c9a-b7c3-373d-72a6" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Wagon" hidden="false" id="2b34-968a-e688-8914" import="true">
      <categoryLinks>
