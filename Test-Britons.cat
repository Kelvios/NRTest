      </constraints>
      <costs>
        <cost name="Support" typeId="7c9a-b7c3-373d-72a6" value="2" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Faggots" hidden="false" id="1413-f3a6-7906-dbef" import="true">
      <categoryLinks>
        <categoryLink id="89f2-90ca-9874-e3d5" name="Support" hidden="false" targetId="593d-f6c4-10ed-66df" primary="true" />
