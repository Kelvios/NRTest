      <costs>
        <cost name="Support" typeId="7c9a-b7c3-373d-72a6" value="2" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Musician" hidden="false" id="9d65-cca9-be3c-b8f4" import="true">
