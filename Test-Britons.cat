    <selectionEntry type="upgrade" name="Chariots" hidden="false" id="8f97-3512-45d5-930b" import="true">
      <categoryLinks>
        <categoryLink id="84a7-7e7e-c179-2d6a" name="Support" hidden="false" targetId="593d-f6c4-10ed-66df" primary="true" />
      </categoryLinks>
      <rules>
        <rule id="e6b6-ad73-6474-6ad6" name="Chariots" hidden="false">
          <description>List Three. Chariots for one Group of Warriors or Noble Warriors. As many may be chosen as there are such Groups.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="0" field="selections" scope="roster" shared="true" id="21b4-d310-f1f6-6182" />
      </constraints>
      <modifiers>
        <modifier type="increment" field="21b4-d310-f1f6-6182" value="1">
          <repeats>
            <repeat field="selections" scope="roster" value="1" shared="true" includeChildSelections="false" includeChildForces="false" childId="db8b-6636-87ef-608a" repeats="1" roundUp="false" />
