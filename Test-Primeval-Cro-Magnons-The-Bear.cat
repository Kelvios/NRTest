<?xml version='1.0' encoding='utf-8'?>
<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema" library="false" id="e628-e731-373e-2a6d" name="Primeval - Cro-Magnons: The Bear" gameSystemId="sys-e140-121e-9b34-0be3" gameSystemRevision="13" revision="13" battleScribeVersion="2.03" type="catalogue" authorName="TRIBAL 2nd Edition rules by Mana Press. NR data authored privately for personal use.">
  <sharedSelectionEntries>
    <selectionEntry type="upgrade" name="Agile (Veteran Skill)" hidden="false" id="b6b1-b8c8-07e2-0383" import="true">
      <rules>
        <rule id="9371-cb88-30a0-d6da" name="Agile" hidden="false">
          <description>The Unit always begins a combat round with Advantage, even if Charged. If both Units engaged in combat have this Skill, the Unit that made the Charge starts with Advantage as normal.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="abe7-5b54-cd31-0177" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Adept [Skilled, long weapons only] (Veteran Skill)" hidden="false" id="1a46-42bc-b229-6451" import="true">
      <rules>
        <rule id="75d2-86da-1c52-cb54" name="Adept" hidden="false">
          <description>After long training with their weapon of choice, this Unit has a Preferred Weapon Bonus of +2 instead of the normal +1. Cannot be combined with Champion or Duellist. Long weapons only (not enforced here).</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="b74b-c606-c900-fe58" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Throwing Weapons (Veteran Skill)" hidden="false" id="99db-25a9-3e83-08f3" import="true">
      <rules>
        <rule id="bb1d-179e-f599-796c" name="Throwing Weapons" hidden="false">
          <description>When this Unit Charges into close combat, flip a card: a black (Spade or Club) card causes 1 hit on the target before the Charge is resolved. Not increased by Strong.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="985e-01ae-bb32-f024" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Skin-Changer (Veteran Skill)" hidden="false" id="3b55-47d3-a64a-6f80" import="true">
      <rules>
        <rule id="b2bc-812d-72dc-6cd0" name="Skin-Changer" hidden="false">
          <description>Characters only. If a wounded Skin-Changer wins an Exchange with a Panic! card, it is resolved with full combat effect.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="6989-adc5-d314-3104" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Seasoned (Elite Skill)" hidden="false" id="d9b2-4cac-e760-7c2d" import="true">
      <rules>
        <rule id="c744-df93-d6f5-34f0" name="Seasoned" hidden="false">
          <description>This Unit may discard and redraw 2 cards from its combat hand before the first Exchange of a combat.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="df6e-26a6-3621-0d2d" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="2" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Lone Hunter (Veteran Skill)" hidden="false" id="8943-164d-ca8c-d27e" import="true">
      <rules>
        <rule id="a890-4d18-8bae-496b" name="Lone Hunter" hidden="false">
          <description>Heroes only. This Hero fires a missile weapon exactly like a unit of Archers, but has no short or long weapon in combat. Any unit it destroys gives the warband no Honour: the Honour goes back to the central supply instead of to the opponent.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="58c1-2632-e15b-fbb7" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Tough (Veteran Skill)" hidden="false" id="edfb-ec96-f2a2-e882" import="true">
      <rules>
        <rule id="9475-c50e-4ea7-86a1" name="Tough" hidden="false">
          <description>Characters only. This Character begins the game with +1 Wound. This extra Wound does not increase its combat hand size.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="3bd1-af05-d7be-4f28" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Strong (Elite Skill)" hidden="false" id="718d-b0d9-eb09-4fad" import="true">
      <rules>
        <rule id="266b-37c8-d3e7-a9b2" name="Strong" hidden="false">
          <description>Characters only. This Character causes +1 hit when it wins a hand-to-hand Exchange with a Spade or Club Strike card.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="aee1-f943-4687-7e8a" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="2" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Short Weapon" hidden="false" id="0479-2d35-1b31-ba78" import="true">
      <rules>
        <rule id="0de3-fdf2-ac7d-cfe7" name="Short Weapon" hidden="false">
          <description>Sword, axe, knife, club or similar. Gives the Preferred Weapon Bonus on Club Strike cards.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="0" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Long Weapon" hidden="false" id="b130-ba09-a8dc-f2fa" import="true">
      <rules>
        <rule id="e71c-f302-b0fa-4c3e" name="Long Weapon" hidden="false">
          <description>Spear, long-axe, pike, polearm or similar. Gives the Preferred Weapon Bonus on Spade Strike cards.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="0" />
      </costs>
    </selectionEntry>
    <selectionEntry type="model" name="Chief (Warlord)" hidden="false" id="3312-8e97-7941-c105" import="true">
      <categoryLinks>
        <categoryLink id="e22d-869f-bc23-68c0" name="Warlord" hidden="false" targetId="21fb-7998-9dc4-5fd0" primary="true" />
