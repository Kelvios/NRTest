      <profiles>
        <profile name="Chief (Warlord)" hidden="false" typeId="49d0-84ee-492f-492f" typeName="Unit" id="fe3e-f07e-9c03-5059">
          <characteristics>
            <characteristic name="Wounds" typeId="aea1-39b1-ec9b-475a">6</characteristic>
            <characteristic name="Skills" typeId="1200-2470-7a16-e426">0-3</characteristic>
            <characteristic name="Notes" typeId="fb14-0b46-30b6-76a9">Always fights and moves alone; never joins Heroes or Formations. Combat hand = 1 card per remaining Wound. Free bonus: 1 free Elite Skill for any 1 Unit in the warband (including itself), OR 1 free Veteran Skill for each of 2 Units -- apply this as a discount when you spend Honour on Skills.</characteristic>
          </characteristics>
        </profile>
      </profiles>
