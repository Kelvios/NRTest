        <profile name="Archers (Formation of 5)" hidden="false" typeId="49d0-84ee-492f-492f" typeName="Unit" id="f21a-36bd-53f3-30d0">
          <characteristics>
            <characteristic name="Wounds" typeId="aea1-39b1-ec9b-475a">1</characteristic>
            <characteristic name="Skills" typeId="1200-2470-7a16-e426">0-2</characteristic>
            <characteristic name="Notes" typeId="fb14-0b46-30b6-76a9">Formation of 5 models, 1 Wound each, Skills apply to the whole Formation. Combat hand = 1 card per surviving model (1-5). Archers are armed with neither short nor long weapons. This tribe may include 1 unit of Archers. (Primeval calls Marksmen 'Archers'.)</characteristic>
          </characteristics>
        </profile>
      </profiles>
