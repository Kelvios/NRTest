            <entryLink name="Hard Target (Veteran Skill)" hidden="false" id="006f-6cd0-7f37-440d" type="selectionEntry" targetId="67f3-c5c1-d937-ecc4" import="true" />
            <entryLink name="Long Shot (Veteran Skill)" hidden="false" id="afc3-c712-c9df-97aa" type="selectionEntry" targetId="6cd8-bac3-4c0e-53d6" import="true" />
            <entryLink name="Ranger (Veteran Skill)" hidden="false" id="12e3-4b93-89b6-be7f" type="selectionEntry" targetId="58f5-0218-8eca-bf9f" import="true" />
            <entryLink name="Savage (Veteran Skill)" hidden="false" id="e0c2-b74f-b662-324c" type="selectionEntry" targetId="5cb8-d8e9-a0b1-018e" import="true" />
            <entryLink name="Survival Instinct (Veteran Skill)" hidden="false" id="5318-26ed-4461-95a8" type="selectionEntry" targetId="a476-ab14-9ced-9abf" import="true" />
