              </entryLinks>
            </selectionEntryGroup>
          </selectionEntryGroups>
          <entryLinks>
            <entryLink name="Agile (Veteran Skill)" hidden="false" id="3135-f341-906e-74d3" type="selectionEntry" targetId="741c-3027-9f25-511f" import="true" />
            <entryLink name="Cunning (Veteran Skill)" hidden="false" id="c89d-75bc-f9b3-e4ed" type="selectionEntry" targetId="7512-1dac-1aaf-28cf" import="true" />
            <entryLink name="Deadly Shot (Veteran Skill)" hidden="false" id="aa21-f1d6-61de-d356" type="selectionEntry" targetId="6000-0795-356c-0a5f" import="true" />
