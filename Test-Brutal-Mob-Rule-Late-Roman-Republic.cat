                <entryLink name="Adept (Veteran Skill)" hidden="false" id="84fb-22e1-c5d3-27f6" type="selectionEntry" targetId="9c24-8986-0d26-8015" import="true" />
                <entryLink name="Duellist (Veteran Skill)" hidden="false" id="c63a-d696-1f50-590c" type="selectionEntry" targetId="8051-9ee1-beba-301d" import="true" />
                <entryLink name="Champion (Elite Skill)" hidden="false" id="cd50-e6d9-4df5-bd9e" type="selectionEntry" targetId="f219-d6d3-063d-b63b" import="true" />
              </entryLinks>
            </selectionEntryGroup>
            <selectionEntryGroup name="Card Pool Bonus Skill (choose up to 1: Respected or Revered; Card Pools option only)" hidden="false" id="eb6c-d310-0603-bc7c">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="6f66-8e59-5ec3-7b98" />
              </constraints>
              <entryLinks>
                <entryLink name="Respected (Veteran Skill)" hidden="false" id="ebb8-54cb-f074-1b98" type="selectionEntry" targetId="596b-22e5-0807-42b5" import="true" />
