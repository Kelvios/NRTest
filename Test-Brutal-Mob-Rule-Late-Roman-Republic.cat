<?xml version='1.0' encoding='utf-8'?>
<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema" library="false" id="263c-691e-3f37-81d0" name="Brutal - Mob Rule (Late Roman Republic)" gameSystemId="sys-e140-121e-9b34-0be3" gameSystemRevision="13" revision="13" battleScribeVersion="2.03" type="catalogue" authorName="TRIBAL 2nd Edition rules by Mana Press. NR data authored privately for personal use.">
  <sharedSelectionEntries>
    <selectionEntry type="upgrade" name="Adept (Veteran Skill)" hidden="false" id="9c24-8986-0d26-8015" import="true">
      <rules>
        <rule id="22d5-f7f5-57a0-8350" name="Adept" hidden="false">
          <description>After long training with their weapon of choice, this Unit has a Preferred Weapon Bonus of +2 instead of the normal +1. Cannot be combined with Champion or Duellist.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="1a1e-bc52-2c35-be23" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Agile (Veteran Skill)" hidden="false" id="741c-3027-9f25-511f" import="true">
      <rules>
        <rule id="da45-0a58-3554-9230" name="Agile" hidden="false">
          <description>The Unit always begins a combat round with Advantage, even if Charged. If both Units engaged in combat have this Skill, the Unit that made the Charge starts with Advantage as normal.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="9ebf-b465-f0b8-daed" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Cunning (Veteran Skill)" hidden="false" id="7512-1dac-1aaf-28cf" import="true">
      <rules>
        <rule id="2135-4c71-bb63-2881" name="Cunning" hidden="false">
          <description>This Unit adds +1 to its card value on any red (Hearts or Diamonds) Feint card played during an Exchange.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="5362-0dac-3c59-66d7" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Deadly Shot (Veteran Skill)" hidden="false" id="6000-0795-356c-0a5f" import="true">
      <rules>
        <rule id="8f8c-1122-d942-0a6a" name="Deadly Shot" hidden="false">
          <description>This Unit adds +2 to its card value when making ranged attacks. Normally only useful for Marksmen, or Characters with the Long Shot Skill.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="91e0-22b2-8af8-5376" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Duellist (Veteran Skill)" hidden="false" id="8051-9ee1-beba-301d" import="true">
      <rules>
        <rule id="c073-b380-24fd-b1f1" name="Duellist" hidden="false">
          <description>Characters only. Gains the Preferred Weapon Bonus from both Spade and Club Strike cards. Cannot be combined with Adept or Champion.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="669d-ccf3-f3b8-1ac8" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Fearsome (Veteran Skill)" hidden="false" id="c71d-97cd-7e8f-c721" import="true">
      <rules>
        <rule id="d7c8-8529-4ba6-ebbd" name="Fearsome" hidden="false">
          <description>This Unit causes +1 hit with Spade or Club Strike cards when it wins an Exchange against a Formation.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="92ac-88a2-9f68-4446" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Hard Target (Veteran Skill)" hidden="false" id="67f3-c5c1-d937-ecc4" import="true">
      <rules>
        <rule id="5007-a350-fef5-3b5e" name="Hard Target" hidden="false">
          <description>Marksmen firing at this Unit suffer -2 to their attack card value.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="46e1-f0a8-1953-1906" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Long Shot (Veteran Skill)" hidden="false" id="6cd8-bac3-4c0e-53d6" import="true">
      <rules>
        <rule id="70b1-3d6a-6c68-8857" name="Long Shot" hidden="false">
          <description>Characters only. This Character may use its Activation Card to make a ranged attack, resolved as a ranged attack from a Unit of Marksmen. Unlike Marksmen, if the target Unit is destroyed this way the player DOES receive Blood Payment.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="7310-eaf9-00a8-b444" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Ranger (Veteran Skill)" hidden="false" id="58f5-0218-8eca-bf9f" import="true">
      <rules>
        <rule id="0182-7968-d4c3-a041" name="Ranger" hidden="false">
          <description>This Unit is not slowed to a Walk when moving through Tough Going, and may Walk (1 short card-edge) across Impassable terrain if it can clear it in a single activation. Cannot be used by Cavalry.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="7a17-8509-c9f5-08f2" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Savage (Veteran Skill)" hidden="false" id="5cb8-d8e9-a0b1-018e" import="true">
      <rules>
        <rule id="40cc-8149-b920-343a" name="Savage" hidden="false">
          <description>This Unit causes +1 hit with Spade or Club Strike cards when it wins an Exchange against a Character.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="16a0-6304-3273-81a8" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Survival Instinct (Veteran Skill)" hidden="false" id="a476-ab14-9ced-9abf" import="true">
      <rules>
        <rule id="8044-ad83-f753-9062" name="Survival Instinct" hidden="false">
          <description>After winning an Exchange, this Unit may break off from combat instead of causing damage: it discards its remaining combat-hand cards and an equal number of the enemy's. The Unit still counts as having lost the combat round (it retreats and the enemy gains the reward).</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="f8c1-6526-77a9-137c" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Tactician (Veteran Skill)" hidden="false" id="f837-48a5-2b52-bb75" import="true">
      <rules>
        <rule id="8814-9746-85a1-7d82" name="Tactician" hidden="false">
          <description>Warlord only. Immediately after the setup phase, the player may reposition 1 enemy Hero or Formation anywhere within the opponent's setup zone.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="9b00-13d4-3483-9a71" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Throwing Weapons (Veteran Skill)" hidden="false" id="c568-bc65-6b2c-5e96" import="true">
      <rules>
        <rule id="166d-1bbe-ad86-a781" name="Throwing Weapons" hidden="false">
          <description>When this Unit Charges into close combat, flip a card: a black (Spade or Club) card causes 1 hit on the target before the Charge is resolved. Not increased by Strong.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="7b66-4951-4037-4660" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Tough (Veteran Skill)" hidden="false" id="6495-e951-a3d5-1975" import="true">
      <rules>
        <rule id="7cfb-9f2c-4e28-d514" name="Tough" hidden="false">
          <description>Characters only. This Character begins the game with +1 Wound. This extra Wound does not increase its combat hand size.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="ce92-420c-6ec4-c905" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Respected (Veteran Skill)" hidden="false" id="596b-22e5-0807-42b5" import="true">
      <rules>
        <rule id="f211-7bfa-db08-501c" name="Respected" hidden="false">
          <description>Warlord only. Card Pools optional rule only. At the start of the game, this Warlord's player draws 1 additional Card Pool card (6 total). Not lost if the Warlord is slain. Cannot be combined with Revered.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="16ce-b7e9-3167-5d0e" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Berserker (Elite Skill)" hidden="false" id="5ea7-dd6f-c314-638c" import="true">
      <rules>
        <rule id="753a-8630-f947-4012" name="Berserker" hidden="false">
          <description>Characters only. This Character always draws its combat hand as if completely unwounded. It suffers -2 to the value of any red (Hearts or Diamonds) Feint card it plays.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="7de3-8ee3-d8fa-81d9" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="2" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Champion (Elite Skill)" hidden="false" id="f219-d6d3-063d-b63b" import="true">
      <rules>
        <rule id="8da3-5175-63c9-4640" name="Champion" hidden="false">
          <description>Characters only. Preferred Weapon Bonus of +2 (instead of +1), plus a further +1 Preferred Weapon Bonus with the other Strike suit. Cannot be combined with Adept or Duellist.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="c276-a73d-2f8f-d286" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="2" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Concealment (Elite Skill)" hidden="false" id="5a7d-941e-e96d-a59a" import="true">
      <rules>
        <rule id="8012-8fb6-5c94-aaeb" name="Concealment" hidden="false">
          <description>Warlord only. During deployment, this player's Units are represented by red (Hearts/Diamonds) cards placed face down: number cards for Formations, face cards for Characters, plus an equal number of black decoy cards. All are revealed and Units placed before the first turn.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="21e4-8b25-ae67-c31e" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="2" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Seasoned (Elite Skill)" hidden="false" id="6181-fda3-c7bb-a0c9" import="true">
      <rules>
        <rule id="970c-c8c8-6c0f-2af9" name="Seasoned" hidden="false">
          <description>This Unit may discard and redraw 2 cards from its combat hand before the first Exchange of a combat.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="649b-0430-933e-a3ec" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="2" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Strong (Elite Skill)" hidden="false" id="426f-e25b-7049-d946" import="true">
      <rules>
        <rule id="01ca-cabb-4985-ec6e" name="Strong" hidden="false">
          <description>Characters only. This Character causes +1 hit when it wins a hand-to-hand Exchange with a Spade or Club Strike card.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="36e3-2f33-fa10-df43" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="2" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Revered (Elite Skill)" hidden="false" id="0dbe-908c-612d-1454" import="true">
      <rules>
        <rule id="7b05-ffd9-f0f8-e6c1" name="Revered" hidden="false">
          <description>Warlord only. Card Pools optional rule only. At the start of the game, this Warlord's player draws 2 additional Card Pool cards (7 total). Not lost if the Warlord is slain. Cannot be combined with Respected.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="c98c-e9da-dfec-7bc1" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="2" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Unarmed" hidden="false" id="afac-745e-8628-2ea4" import="true">
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="0" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Short Weapon" hidden="false" id="975b-0c83-6641-1d02" import="true">
      <rules>
        <rule id="7dde-6890-3a14-bcf8" name="Short Weapon" hidden="false">
          <description>Sword, axe, knife, club or similar. Gives the Preferred Weapon Bonus on Club Strike cards.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="0" />
      </costs>
    </selectionEntry>
    <selectionEntry type="model" name="Chief" hidden="false" id="0cca-9ffc-40c4-cb0e" import="true">
      <categoryLinks>
        <categoryLink id="a261-f3e5-fceb-d3c2" name="Warlord" hidden="false" targetId="21fb-7998-9dc4-5fd0" primary="true" />
      </categoryLinks>
      <profiles>
        <profile name="Chief" hidden="false" typeId="49d0-84ee-492f-492f" typeName="Unit" id="0597-69d6-b2a1-e760">
          <characteristics>
            <characteristic name="Wounds" typeId="aea1-39b1-ec9b-475a">6</characteristic>
            <characteristic name="Skills" typeId="1200-2470-7a16-e426">0-3</characteristic>
            <characteristic name="Notes" typeId="fb14-0b46-30b6-76a9">Always fights and moves alone; never joins Heroes or Formations. Combat hand = 1 card per remaining Wound. Free bonus: 1 free Elite Skill for any 1 Unit in the warband (including itself), OR 1 free Veteran Skill for each of 2 Units -- apply this as a discount when you spend Honour on Skills.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink id="28a5-b731-17d1-8fae" name="Street Weapons" hidden="false" targetId="c36a-396b-1636-26e6" type="rule" />
        <infoLink id="b1ce-4496-f5b4-ae73" name="Beat Down!" hidden="false" targetId="0be4-00a2-d6e5-1b9f" type="rule" />
        <infoLink id="0b49-c196-49eb-423d" name="No Missile Weapons" hidden="false" targetId="5bf1-1fd4-2b8f-5405" type="rule" />
        <infoLink id="631d-a883-0df0-c015" name="Toughs" hidden="false" targetId="4b10-7d57-2e55-dabb" type="rule" />
        <infoLink id="ef7b-c063-78f2-6fef" name="The Power of Oratory" hidden="false" targetId="8d0f-3f82-6780-8332" type="rule" />
        <infoLink id="1008-3b45-848b-4f27" name="Faction Stronghold" hidden="false" targetId="7200-81de-f9de-fcf2" type="rule" />
      </infoLinks>
      <selectionEntryGroups>
        <selectionEntryGroup name="Weapon (choose 1)" hidden="false" id="70dd-e9dc-a904-0690" defaultSelectionEntryId="6037-99d8-e7fc-3cf1">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="3743-3d40-af31-a1a3" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="5dfb-58d0-b440-7d41" />
          </constraints>
          <entryLinks>
            <entryLink name="Unarmed" hidden="false" id="4125-d4cb-ce07-25ce" type="selectionEntry" targetId="afac-745e-8628-2ea4" import="true" />
            <entryLink name="Short Weapon" hidden="false" id="6037-99d8-e7fc-3cf1" type="selectionEntry" targetId="975b-0c83-6641-1d02" import="true" />
          </entryLinks>
        </selectionEntryGroup>
        <selectionEntryGroup name="Skills (choose up to 3)" hidden="false" id="b111-eb0c-abe2-65ae">
          <constraints>
            <constraint type="max" value="3" field="selections" scope="parent" shared="true" id="32ea-db5a-9c44-b28e" />
          </constraints>
          <selectionEntryGroups>
            <selectionEntryGroup name="Weapon Mastery Skill (choose up to 1: Adept, Duellist or Champion)" hidden="false" id="8e4e-0653-8340-c5da">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="47f8-5a56-6bba-1e65" />
