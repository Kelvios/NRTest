<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema" library="false" id="7578-b830-781d-8f35" name="Brutal - Masked Vigilantes: Villainous" gameSystemId="sys-e140-121e-9b34-0be3" gameSystemRevision="13" revision="13" battleScribeVersion="2.03" type="catalogue" authorName="TRIBAL 2nd Edition rules by Mana Press. NR data authored privately for personal use.">
  <forceEntries>
    <forceEntry id="e331-de87-3553-282c" name="Villainous Gang" hidden="false">
      <categoryLinks>
        <categoryLink id="e8dc-bb73-b4e2-3e5c" name="Warlord" hidden="false" targetId="21fb-7998-9dc4-5fd0" type="category">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="869c-b507-547d-8be6" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="8a9a-029a-482c-acbc" />
          </constraints>
        </categoryLink>
        <categoryLink id="73d6-18dc-29db-61f4" name="Heroes" hidden="false" targetId="cdf2-4f60-5c31-a783" type="category">
          <constraints>
            <constraint type="min" value="0" field="selections" scope="parent" shared="true" id="e292-08ee-29e3-a29e" />
            <constraint type="max" value="0" field="selections" scope="parent" shared="true" id="ef69-246b-07d1-3861" />
          </constraints>
          <modifiers>
            <modifier type="increment" field="ef69-246b-07d1-3861" value="1">
              <repeats>
                <repeat field="selections" scope="force" value="1" shared="true" includeChildSelections="false" includeChildForces="false" childId="a20b-aa4e-9045-9c20" repeats="1" roundUp="false" />
              </repeats>
            </modifier>
          </modifiers>
        </categoryLink>
        <categoryLink id="bc56-0432-41f6-3887" name="Warriors" hidden="false" targetId="a20b-aa4e-9045-9c20" type="category">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="aedd-456e-94e6-0913" />
          </constraints>
        </categoryLink>
      </categoryLinks>
    </forceEntry>
  </forceEntries>
  <sharedSelectionEntries>
    <selectionEntry type="upgrade" name="Adept (Veteran Skill)" hidden="false" id="661e-d394-e9b0-ed90" import="true">
      <rules>
        <rule id="b18a-8bcc-1005-6d6e" name="Adept" hidden="false">
          <description>After long training with their weapon of choice, this Unit has a Preferred Weapon Bonus of +2 instead of the normal +1. Cannot be combined with Champion or Duellist.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="73fc-94c5-1371-d12e" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Agile (Veteran Skill)" hidden="false" id="e2c9-af82-f4b2-00f4" import="true">
      <rules>
        <rule id="5825-a041-6299-8fc0" name="Agile" hidden="false">
          <description>The Unit always begins a combat round with Advantage, even if Charged. If both Units engaged in combat have this Skill, the Unit that made the Charge starts with Advantage as normal.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="cad5-b9b4-b308-dcbc" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Cunning (Veteran Skill)" hidden="false" id="5ed6-80de-8efa-7d03" import="true">
      <rules>
        <rule id="80e0-5a89-bf4b-7e9c" name="Cunning" hidden="false">
          <description>This Unit adds +1 to its card value on any red (Hearts or Diamonds) Feint card played during an Exchange.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="f9fc-aac9-e3df-0df6" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Deadly Shot (Veteran Skill)" hidden="false" id="968d-215a-1d1d-dfae" import="true">
      <rules>
        <rule id="7e22-da87-5b31-4636" name="Deadly Shot" hidden="false">
          <description>This Unit adds +2 to its card value when making ranged attacks. Normally only useful for Marksmen, or Characters with the Long Shot Skill.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="1231-7b53-e5ec-de75" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Duellist (Veteran Skill)" hidden="false" id="0dd4-029c-06be-8730" import="true">
      <rules>
        <rule id="8807-4ced-5643-0952" name="Duellist" hidden="false">
          <description>Characters only. Gains the Preferred Weapon Bonus from both Spade and Club Strike cards. Cannot be combined with Adept or Champion.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="bf4f-049b-98c2-d63d" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Fearsome (Veteran Skill)" hidden="false" id="4ecf-616e-967f-1394" import="true">
      <rules>
        <rule id="ec38-f516-6ccd-ab9b" name="Fearsome" hidden="false">
          <description>This Unit causes +1 hit with Spade or Club Strike cards when it wins an Exchange against a Formation.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="6d18-34a4-49f4-ac75" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Hard Target (Veteran Skill)" hidden="false" id="e18a-a99e-520b-001a" import="true">
      <rules>
        <rule id="a5f6-aff1-f937-7881" name="Hard Target" hidden="false">
          <description>Marksmen firing at this Unit suffer -2 to their attack card value.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="f82c-6938-d906-2068" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Long Shot (Veteran Skill)" hidden="false" id="7baf-caf7-f804-586b" import="true">
      <rules>
        <rule id="d62f-b037-47e6-3bd4" name="Long Shot" hidden="false">
          <description>Characters only. This Character may use its Activation Card to make a ranged attack, resolved as a ranged attack from a Unit of Marksmen. Unlike Marksmen, if the target Unit is destroyed this way the player DOES receive Blood Payment.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="70dd-60c0-5f3e-6e97" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Ranger (Veteran Skill)" hidden="false" id="dce9-2e74-29ac-2bdb" import="true">
      <rules>
        <rule id="c0cc-a05c-a634-c8ac" name="Ranger" hidden="false">
          <description>This Unit is not slowed to a Walk when moving through Tough Going, and may Walk (1 short card-edge) across Impassable terrain if it can clear it in a single activation. Cannot be used by Cavalry.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="3f77-6ad5-692b-7559" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Savage (Veteran Skill)" hidden="false" id="8c7b-d039-4f6c-c117" import="true">
      <rules>
        <rule id="e09d-3b9d-e8af-28f6" name="Savage" hidden="false">
          <description>This Unit causes +1 hit with Spade or Club Strike cards when it wins an Exchange against a Character.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="5a7e-6fac-d546-9816" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Survival Instinct (Veteran Skill)" hidden="false" id="e20b-e871-2d0a-8881" import="true">
      <rules>
        <rule id="b3d2-8cc0-1e2b-b8e2" name="Survival Instinct" hidden="false">
          <description>Characters only. When a fight is going badly the hero may try to break away: the next successful Exchange does no damage; instead the Character and the enemy each discard the Character's remaining combat hand cards (the enemy's drawn at random if larger), each counting as a completed Exchange. (Brutal version; replaces the core Survival Instinct.)</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="203c-f3f5-0d61-3e88" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Tactician (Veteran Skill)" hidden="false" id="6e80-25b5-cef4-f244" import="true">
      <rules>
        <rule id="1113-685c-4d83-11da" name="Tactician" hidden="false">
          <description>Warlord only. Immediately after the setup phase, the player may reposition 1 enemy Hero or Formation anywhere within the opponent's setup zone.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="f474-dc4b-6ab3-a684" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Throwing Weapons (Veteran Skill)" hidden="false" id="4c81-5e56-7397-5947" import="true">
      <rules>
        <rule id="9fe6-7173-4b1f-95c4" name="Throwing Weapons" hidden="false">
          <description>When this Unit Charges into close combat, flip a card: a black (Spade or Club) card causes 1 hit on the target before the Charge is resolved. Not increased by Strong.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="b905-3287-b210-7bde" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Tough (Veteran Skill)" hidden="false" id="d9c6-0dab-a0a3-5c0c" import="true">
      <rules>
        <rule id="33c7-135b-77a6-acf2" name="Tough" hidden="false">
          <description>Characters only. This Character begins the game with +1 Wound. This extra Wound does not increase its combat hand size.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="3ffd-34c8-43e5-76ce" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Respected (Veteran Skill)" hidden="false" id="226e-54da-2ed3-b050" import="true">
      <rules>
        <rule id="b157-d7d5-bb8b-2d21" name="Respected" hidden="false">
          <description>Warlord only. Card Pools optional rule only. At the start of the game, this Warlord's player draws 1 additional Card Pool card (6 total). Not lost if the Warlord is slain. Cannot be combined with Revered.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="72f1-ffa2-c0cd-1f09" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Berserker (Elite Skill)" hidden="false" id="4c1c-b846-4982-53a1" import="true">
      <rules>
        <rule id="caf7-1f6a-31cc-e196" name="Berserker" hidden="false">
          <description>Characters only. This Character always draws its combat hand as if completely unwounded. It suffers -2 to the value of any red (Hearts or Diamonds) Feint card it plays.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="07de-cd10-1615-372c" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="2" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Champion (Elite Skill)" hidden="false" id="fd51-9d66-a545-37ec" import="true">
      <rules>
        <rule id="6780-ad45-c840-9913" name="Champion" hidden="false">
          <description>Characters only. Preferred Weapon Bonus of +2 (instead of +1), plus a further +1 Preferred Weapon Bonus with the other Strike suit. Cannot be combined with Adept or Duellist.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="bbfa-a578-df57-dd3d" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="2" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Concealment (Elite Skill)" hidden="false" id="95d1-fe5c-50bf-6aae" import="true">
      <rules>
        <rule id="6df9-2cb2-7a73-c014" name="Concealment" hidden="false">
          <description>Warlord only. During deployment, this player's Units are represented by red (Hearts/Diamonds) cards placed face down: number cards for Formations, face cards for Characters, plus an equal number of black decoy cards. All are revealed and Units placed before the first turn.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="b26d-b8a8-a0d0-138a" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="2" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Seasoned (Elite Skill)" hidden="false" id="1f69-e46b-7b57-1a96" import="true">
      <rules>
        <rule id="5f99-8e99-3899-6f22" name="Seasoned" hidden="false">
          <description>This Unit may discard and redraw 2 cards from its combat hand before the first Exchange of a combat.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="82d6-1676-a9a9-d224" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="2" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Strong (Elite Skill)" hidden="false" id="9e65-70a0-c26f-f970" import="true">
      <rules>
        <rule id="9bff-d4b5-2534-deb5" name="Strong" hidden="false">
          <description>Characters only. This Character causes +1 hit when it wins a hand-to-hand Exchange with a Spade or Club Strike card.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="4546-f2d1-c09a-d49a" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="2" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Revered (Elite Skill)" hidden="false" id="b977-7ac3-bdd5-e43c" import="true">
      <rules>
        <rule id="7807-423d-9582-b083" name="Revered" hidden="false">
          <description>Warlord only. Card Pools optional rule only. At the start of the game, this Warlord's player draws 2 additional Card Pool cards (7 total). Not lost if the Warlord is slain. Cannot be combined with Respected.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="481f-0cfa-db5a-3d06" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="2" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Body Armour (Veteran Skill)" hidden="false" id="8d26-b0b8-3887-1b97" import="true">
      <rules>
        <rule id="2911-c4bb-0f97-6b6b" name="Body Armour" hidden="false">
          <description>Characters only. When a model wearing body armour takes a hit, draw a card: a Jack (11) or more cancels the hit. Against an Overpower or Mighty Blow only one of the two wounds can be cancelled.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="e9cb-b770-a86b-0485" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Unarmed" hidden="false" id="d7ee-dfbe-7f98-02f5" import="true">
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="0" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Short Weapon" hidden="false" id="fa7d-65f8-8a24-84a7" import="true">
      <rules>
        <rule id="4cb1-96ee-f5a3-5205" name="Short Weapon" hidden="false">
          <description>Sword, axe, knife, club or similar. Gives the Preferred Weapon Bonus on Club Strike cards.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="0" />
      </costs>
    </selectionEntry>
    <selectionEntry type="model" name="Chief" hidden="false" id="8596-da8d-b2ff-ae01" import="true">
      <categoryLinks>
        <categoryLink id="1d83-7400-4ac4-f5a2" name="Warlord" hidden="false" targetId="21fb-7998-9dc4-5fd0" primary="true" />
      </categoryLinks>
      <profiles>
        <profile name="Chief" hidden="false" typeId="49d0-84ee-492f-492f" typeName="Unit" id="bfee-4f66-f58f-93f6">
          <characteristics>
            <characteristic name="Wounds" typeId="aea1-39b1-ec9b-475a">6</characteristic>
            <characteristic name="Skills" typeId="1200-2470-7a16-e426">0-3</characteristic>
            <characteristic name="Notes" typeId="fb14-0b46-30b6-76a9">Always fights and moves alone; never joins Heroes or Formations. Combat hand = 1 card per remaining Wound. Free bonus: 1 free Elite Skill for any 1 Unit in the warband (including itself), OR 1 free Veteran Skill for each of 2 Units -- apply this as a discount when you spend Honour on Skills.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink id="d290-bd59-f596-922a" name="Street Weapons" hidden="false" targetId="12c1-ffce-0379-d334" type="rule" />
        <infoLink id="6375-4414-b516-57dc" name="Beat Down!" hidden="false" targetId="1b92-0311-0d49-7052" type="rule" />
        <infoLink id="b7ac-c331-01eb-46a3" name="No Missile Weapons" hidden="false" targetId="d3f4-7ebf-5e4a-2d70" type="rule" />
        <infoLink id="60e4-8a18-b706-6e74" name="Toughs" hidden="false" targetId="0bbf-1e39-adad-e5e4" type="rule" />
        <infoLink id="aafe-c68f-236e-59db" name="Mighty Blow" hidden="false" targetId="5578-a7ff-29c9-37de" type="rule" />
        <infoLink id="ab2a-cac9-ce91-bf97" name="Firearms and Super Powers" hidden="false" targetId="9d82-f268-7d2c-c80f" type="rule" />
        <infoLink id="543f-ab3c-1710-202c" name="Villainous Chief" hidden="false" targetId="8ac3-e24b-6eeb-75cd" type="rule" />
      </infoLinks>
      <selectionEntryGroups>
        <selectionEntryGroup name="Weapon (choose 1)" hidden="false" id="54ad-f927-9e9a-4413" defaultSelectionEntryId="baa1-6b74-b834-2612">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="4ea1-e99b-0db7-2919" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="1c42-d46c-55a8-598f" />
          </constraints>
          <entryLinks>
            <entryLink name="Unarmed" hidden="false" id="51ca-9f7d-a25c-d216" type="selectionEntry" targetId="d7ee-dfbe-7f98-02f5" import="true" />
            <entryLink name="Short Weapon" hidden="false" id="baa1-6b74-b834-2612" type="selectionEntry" targetId="fa7d-65f8-8a24-84a7" import="true" />
          </entryLinks>
        </selectionEntryGroup>
        <selectionEntryGroup name="Skills (choose up to 3)" hidden="false" id="beaf-885a-4b9f-8f41">
          <constraints>
            <constraint type="max" value="3" field="selections" scope="parent" shared="true" id="9003-7af8-254d-401c" />
          </constraints>
          <selectionEntryGroups>
            <selectionEntryGroup name="Weapon Mastery Skill (choose up to 1: Adept, Duellist or Champion)" hidden="false" id="dc52-def4-2aeb-c564">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="67a3-a69c-80fb-85cd" />
              </constraints>
              <entryLinks>
                <entryLink name="Adept (Veteran Skill)" hidden="false" id="30fd-3960-68af-ab58" type="selectionEntry" targetId="661e-d394-e9b0-ed90" import="true" />
                <entryLink name="Duellist (Veteran Skill)" hidden="false" id="4272-10bf-714a-f2bf" type="selectionEntry" targetId="0dd4-029c-06be-8730" import="true" />
                <entryLink name="Champion (Elite Skill)" hidden="false" id="eac1-6983-e96c-8a35" type="selectionEntry" targetId="fd51-9d66-a545-37ec" import="true" />
              </entryLinks>
            </selectionEntryGroup>
