<?xml version='1.0' encoding='utf-8'?>
<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema" library="false" id="9e9a-e77c-1122-3ab6" name="Primeval - Cro-Magnons: The Cat" gameSystemId="sys-e140-121e-9b34-0be3" gameSystemRevision="12" revision="12" battleScribeVersion="2.03" type="catalogue" authorName="TRIBAL 2nd Edition rules by Mana Press. NR data authored privately for personal use.">
  <sharedSelectionEntries>
    <selectionEntry type="upgrade" name="Agile (Veteran Skill)" hidden="false" id="4d06-27b4-7516-8e77" import="true">
      <rules>
        <rule id="9469-c58d-bf5f-ab01" name="Agile" hidden="false">
          <description>The Unit always begins a combat round with Advantage, even if Charged. If both Units engaged in combat have this Skill, the Unit that made the Charge starts with Advantage as normal.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="d915-2c0e-17af-b125" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Adept [Skilled, long weapons only] (Veteran Skill)" hidden="false" id="31a4-3ab1-d529-1a14" import="true">
      <rules>
        <rule id="6adf-0f84-cd86-d0bc" name="Adept" hidden="false">
          <description>After long training with their weapon of choice, this Unit has a Preferred Weapon Bonus of +2 instead of the normal +1. Cannot be combined with Champion or Duellist. Long weapons only (not enforced here).</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="f47b-6e20-adf7-43e9" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Throwing Weapons (Veteran Skill)" hidden="false" id="5fd1-807b-1a4a-1650" import="true">
      <rules>
        <rule id="49eb-8fa0-4801-b59b" name="Throwing Weapons" hidden="false">
          <description>When this Unit Charges into close combat, flip a card: a black (Spade or Club) card causes 1 hit on the target before the Charge is resolved. Not increased by Strong.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="a929-cba2-c5a0-3014" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Skin-Changer (Veteran Skill)" hidden="false" id="6fcf-9bf6-e1d0-d989" import="true">
      <rules>
        <rule id="6901-3830-dc74-0ece" name="Skin-Changer" hidden="false">
          <description>Characters only. If a wounded Skin-Changer wins an Exchange with a Panic! card, it is resolved with full combat effect.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="d712-481d-d1a2-c46d" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Seasoned (Elite Skill)" hidden="false" id="adb5-5e0e-2588-404f" import="true">
      <rules>
        <rule id="f72d-960e-af3c-8e3e" name="Seasoned" hidden="false">
          <description>This Unit may discard and redraw 2 cards from its combat hand before the first Exchange of a combat.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="8ead-6feb-4404-e7ff" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="2" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Lone Hunter (Veteran Skill)" hidden="false" id="2d52-756c-b183-87a7" import="true">
      <rules>
        <rule id="0145-71ff-6378-5d4f" name="Lone Hunter" hidden="false">
          <description>Heroes only. This Hero fires a missile weapon exactly like a unit of Archers, but has no short or long weapon in combat. Any unit it destroys gives the warband no Honour: the Honour goes back to the central supply instead of to the opponent.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="c3bc-1194-a002-363f" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Savage (Veteran Skill)" hidden="false" id="e121-4dc5-8c1c-76fb" import="true">
      <rules>
        <rule id="47a2-6381-2c02-3365" name="Savage" hidden="false">
          <description>+1 wound damage from hits with Strike Cards when fighting single-model units. (Primeval version; replaces the core Savage.)</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="5394-a581-a4eb-bad4" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Concealment (Veteran Skill)" hidden="false" id="910a-32f9-acc2-09c3" import="true">
      <rules>
        <rule id="75a9-211a-8149-e84b" name="Concealment" hidden="false">
          <description>Chief only. At setup the warband uses face-down red cards to stand for its units (number cards for Warriors, face cards for Characters), with an equal number of black decoy cards; just before the first turn all are flipped and units are placed where a matching red card lay. (Primeval version; replaces the core Concealment.)</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="242e-ffb3-3541-6374" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Short Weapon" hidden="false" id="3248-d301-9f46-dad1" import="true">
      <rules>
        <rule id="befb-c43d-321b-9139" name="Short Weapon" hidden="false">
          <description>Sword, axe, knife, club or similar. Gives the Preferred Weapon Bonus on Club Strike cards.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="0" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Long Weapon" hidden="false" id="8ecc-ebb3-4bd8-6855" import="true">
      <rules>
        <rule id="8474-93fc-b866-6cbf" name="Long Weapon" hidden="false">
          <description>Spear, long-axe, pike, polearm or similar. Gives the Preferred Weapon Bonus on Spade Strike cards.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="0" />
      </costs>
    </selectionEntry>
    <selectionEntry type="model" name="Chief (Warlord)" hidden="false" id="73a2-e712-bc22-1f06" import="true">
      <categoryLinks>
        <categoryLink id="4b33-c6d6-3b6d-f462" name="Warlord" hidden="false" targetId="21fb-7998-9dc4-5fd0" primary="true" />
