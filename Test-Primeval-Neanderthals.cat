<?xml version='1.0' encoding='utf-8'?>
<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema" library="false" id="eb54-d675-a68b-b8d5" name="Primeval - Neanderthals" gameSystemId="sys-e140-121e-9b34-0be3" gameSystemRevision="12" revision="12" battleScribeVersion="2.03" type="catalogue" authorName="TRIBAL 2nd Edition rules by Mana Press. NR data authored privately for personal use.">
  <sharedSelectionEntries>
    <selectionEntry type="upgrade" name="Fearsome (Veteran Skill)" hidden="false" id="e947-69a3-1823-29da" import="true">
      <rules>
        <rule id="1cab-abbe-da56-1d4b" name="Fearsome" hidden="false">
          <description>+1 wound damage from hits with Strike Cards when fighting units of more than one miniature. Characters with dogs attached still count as a single miniature, so they are not subject to it. (Primeval update to the core Fearsome.)</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="2c77-7433-2e07-59dc" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Ferocious Fighter (Veteran Skill)" hidden="false" id="db2a-d84d-6c69-adea" import="true">
      <rules>
        <rule id="897f-becf-2324-72d8" name="Ferocious Fighter" hidden="false">
          <description>Characters only. Its combat hand is not reduced as it loses wounds, but it is clumsy in defence: -2 to the value of any red Feint card it plays.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="c0b3-aa9d-7c16-c282" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Savage (Veteran Skill)" hidden="false" id="bc73-0579-85c9-902d" import="true">
      <rules>
        <rule id="b0ba-d68c-21b0-f5e6" name="Savage" hidden="false">
          <description>+1 wound damage from hits with Strike Cards when fighting single-model units. (Primeval version; replaces the core Savage.)</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="6922-1f70-38bf-f98b" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Adept [Skilled, short weapons only] (Veteran Skill)" hidden="false" id="07b2-2640-311b-0220" import="true">
      <rules>
        <rule id="2ba7-c7f0-07e4-dd78" name="Adept" hidden="false">
          <description>After long training with their weapon of choice, this Unit has a Preferred Weapon Bonus of +2 instead of the normal +1. Cannot be combined with Champion or Duellist. Short weapons only (not enforced here).</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="9f75-9c23-be54-2f70" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Tough (Veteran Skill)" hidden="false" id="b420-48cb-5458-6fb7" import="true">
      <rules>
        <rule id="2cae-905e-007a-a2ca" name="Tough" hidden="false">
          <description>Characters only. This Character begins the game with +1 Wound. This extra Wound does not increase its combat hand size.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="3939-ae83-c0c2-ac30" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Champion (Elite Skill)" hidden="false" id="b750-3878-4b94-43da" import="true">
      <rules>
        <rule id="0a55-6a7c-2ed0-15db" name="Champion" hidden="false">
          <description>Characters only. Preferred Weapon Bonus of +2 (instead of +1), plus a further +1 Preferred Weapon Bonus with the other Strike suit. Cannot be combined with Adept or Duellist.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="b166-6a1c-6957-1446" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="2" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Strong (Elite Skill)" hidden="false" id="061c-0509-b6cd-16ec" import="true">
      <rules>
        <rule id="0013-baf6-423f-a7bd" name="Strong" hidden="false">
          <description>Characters only. This Character causes +1 hit when it wins a hand-to-hand Exchange with a Spade or Club Strike card.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="5ecc-f091-6e9e-49d6" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="2" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="The One Who Knows (Elite Skill)" hidden="false" id="5f86-e2a3-8a09-f2fd" import="true">
      <rules>
        <rule id="ea50-825a-a328-edb7" name="The One Who Knows" hidden="false">
          <description>Chiefs only. When the tribe is the attacker in a scenario it can plan its assault around the weather, using one of two options. Stalkers in the Mist: a hidden setup using a pair of counters for each unit. Hunters of the Storm: an icy storm in which all models have the Stocky Build rule, Throwing Weapons attacks draw two cards and play the worst, and Archers get -3 on missile attacks, until two Aces are played in one Exchange.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="3fc6-b998-9af7-8c8f" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="2" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Short Weapon" hidden="false" id="9e4b-f58f-0200-8054" import="true">
      <rules>
        <rule id="1d26-7169-75ae-e86c" name="Short Weapon" hidden="false">
          <description>Sword, axe, knife, club or similar. Gives the Preferred Weapon Bonus on Club Strike cards.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="0" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Long Weapon" hidden="false" id="2689-04aa-91c4-9ef1" import="true">
      <rules>
        <rule id="3f98-fa55-ceff-e7df" name="Long Weapon" hidden="false">
          <description>Spear, long-axe, pike, polearm or similar. Gives the Preferred Weapon Bonus on Spade Strike cards.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="0" />
      </costs>
    </selectionEntry>
    <selectionEntry type="model" name="Chief (Warlord)" hidden="false" id="7e0b-0548-b4b9-9291" import="true">
