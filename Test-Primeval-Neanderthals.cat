  <sharedRules>
    <rule id="2d34-6738-d8fc-3367" name="No Ranged Weapons" hidden="false">
      <description>Neanderthals had no bow or spear-thrower, so they may not include Archers and may not take the Throwing Weapons Skill.</description>
    </rule>
    <rule id="d6de-2038-1e32-3066" name="Stocky Build" hidden="false">
      <description>When Sprinting, a Neanderthal unit may move only 1 long + 1 short card-edge at most. Pushing through Tough Going at a Sprint, it moves the normal distance of 2 short card-lengths.</description>
    </rule>
    <rule id="7b81-b54d-c49f-9d2b" name="Resilient" hidden="false">
      <description>A Neanderthal unit begins to lose cards from its combat hand only after its second and later wounds.</description>
    </rule>
  </sharedRules>
  <entryLinks>
