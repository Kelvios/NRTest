      </categoryLinks>
      <rules>
        <rule id="7ca0-0f1e-7e1c-deb7" name="Battering Ram" hidden="false">
          <description>List Three. Named in the Germans' support list. The book gives no description or limit for it here.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Support" typeId="7c9a-b7c3-373d-72a6" value="3" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Arminius' Wall" hidden="false" id="6e1a-1ce3-a4dc-c880" import="true">
      <categoryLinks>
        <categoryLink id="6d92-87bf-8be3-7a68" name="Support" hidden="false" targetId="593d-f6c4-10ed-66df" primary="true" />
      </categoryLinks>
      <rules>
        <rule id="e869-60ea-ec07-fc32" name="Arminius' Wall" hidden="false">
          <description>List Three. A rough turf wall masking troop deployment, not placed on the table. Allows two additional Groups to Ambush or Deploy from low-standing terrain, and mounted Groups to deploy from it. The book sets no maximum.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Support" typeId="7c9a-b7c3-373d-72a6" value="3" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Secret Way" hidden="false" id="85a4-a7da-582e-3023" import="true">
      <categoryLinks>
        <categoryLink id="1658-4c8a-7b02-b31f" name="Support" hidden="false" targetId="593d-f6c4-10ed-66df" primary="true" />
      </categoryLinks>
      <rules>
        <rule id="9559-6b98-3c28-210c" name="Secret Way" hidden="false">
          <description>List Four. Lets the German player ignore the effects of one area of wood or Forest. Note your choice to show your opponent. Maximum one.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="014a-dbe3-bac0-3515" />
      </constraints>
      <costs>
        <cost name="Support" typeId="7c9a-b7c3-373d-72a6" value="4" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Status II Leader (Support)" hidden="false" id="950b-1c86-c159-1930" import="true">
      <categoryLinks>
        <categoryLink id="1a17-4292-8c52-2695" name="Support" hidden="false" targetId="593d-f6c4-10ed-66df" primary="true" />
      </categoryLinks>
      <rules>
        <rule id="bffd-d3da-e1be-bb71" name="Status II Leader (Support)" hidden="false">
          <description>List Six. A named Status II leader taken as support.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Support" typeId="7c9a-b7c3-373d-72a6" value="6" />
      </costs>
    </selectionEntry>
  </sharedSelectionEntries>
