    <selectionEntry type="upgrade" name="Supra Numerum Leader (Support)" hidden="false" id="99b5-32a2-a9b6-f1b0" import="true">
      <categoryLinks>
        <categoryLink id="03b8-0d16-9718-4ad3" name="Support" hidden="false" targetId="593d-f6c4-10ed-66df" primary="true" />
      </categoryLinks>
      <rules>
        <rule id="e55c-1c05-9a19-2afb" name="Supra Numerum Leader (Support)" hidden="false">
          <description>List One. A leader who is not on the table and has no command initiatives. Only Status I, Status II and Supra Numerum leaders may be chosen as support.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Support" typeId="7c9a-b7c3-373d-72a6" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Wagon" hidden="false" id="80f7-2ef0-139e-8fb3" import="true">
      <categoryLinks>
        <categoryLink id="c70c-ca7f-8fe3-668a" name="Support" hidden="false" targetId="593d-f6c4-10ed-66df" primary="true" />
      </categoryLinks>
      <rules>
        <rule id="2c50-a94c-80c6-f402" name="Wagon" hidden="false">
          <description>List Two. Limited supplies; Groups out of ammunition can resupply from it. Maximum two.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="2" field="selections" scope="roster" shared="true" id="7668-cc18-46c9-ff57" />
      </constraints>
      <costs>
        <cost name="Support" typeId="7c9a-b7c3-373d-72a6" value="2" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Wailing Women" hidden="false" id="35af-4894-3cb8-2a70" import="true">
      <categoryLinks>
        <categoryLink id="b3f1-6e55-2f75-f835" name="Support" hidden="false" targetId="593d-f6c4-10ed-66df" primary="true" />
      </categoryLinks>
      <rules>
        <rule id="2da5-3f8b-5beb-e8dc" name="Wailing Women" hidden="false">
          <description>List Two. A marker placed within 12 inches of a Barbarian Group or Mob as a Rallying Point; Groups falling back on it each remove two points of Shock (erratum merged). The book sets no maximum.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Support" typeId="7c9a-b7c3-373d-72a6" value="2" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Musician" hidden="false" id="d284-1a66-88c4-fcf3" import="true">
      <categoryLinks>
        <categoryLink id="f641-555f-fe1d-e470" name="Support" hidden="false" targetId="593d-f6c4-10ed-66df" primary="true" />
      </categoryLinks>
      <rules>
        <rule id="1d42-de29-7885-8789" name="Musician" hidden="false">
          <description>List Two. Attached to the force commander to double his Command Range. Maximum one.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="2052-5c51-9e44-795c" />
      </constraints>
      <costs>
        <cost name="Support" typeId="7c9a-b7c3-373d-72a6" value="2" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Faggots" hidden="false" id="5c84-7a2f-c7e0-aaeb" import="true">
      <categoryLinks>
        <categoryLink id="8adf-66d3-72c3-2737" name="Support" hidden="false" targetId="593d-f6c4-10ed-66df" primary="true" />
      </categoryLinks>
      <rules>
        <rule id="1a6e-b5bd-1a98-429f" name="Faggots" hidden="false">
