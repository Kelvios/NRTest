    <selectionEntry type="unit" name="Warriors (Formation of 5)" hidden="false" id="cdc7-1848-e902-0baa" import="true">
      <categoryLinks>
        <categoryLink id="13a0-32d2-247b-6aa0" name="Warriors (Formation of 5)" hidden="false" targetId="a20b-aa4e-9045-9c20" primary="true" />
      </categoryLinks>
      <profiles>
        <profile name="Warriors (Formation of 5)" hidden="false" typeId="49d0-84ee-492f-492f" typeName="Unit" id="59c9-f6ed-5490-9e59">
          <characteristics>
            <characteristic name="Wounds" typeId="aea1-39b1-ec9b-475a">1</characteristic>
            <characteristic name="Skills" typeId="1200-2470-7a16-e426">0-2</characteristic>
            <characteristic name="Notes" typeId="fb14-0b46-30b6-76a9">Formation of 5 models, 1 Wound each, Skills apply to the whole Formation. Combat hand = 1 card per surviving model (1-5). All models in the Formation are armed with the same weapon type (a rule of thumb allows 1-2 oddly-armed models for looks only).</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink id="4b15-4abe-11e7-58de" name="No Ranged Weapons" hidden="false" targetId="184f-2267-491d-6ebb" type="rule" />
      </infoLinks>
