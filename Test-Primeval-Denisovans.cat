    <selectionEntry type="model" name="Heroes" hidden="false" id="4f24-94b1-5c08-da29" import="true">
      <categoryLinks>
        <categoryLink id="8aec-ea01-f43a-1c64" name="Heroes" hidden="false" targetId="cdf2-4f60-5c31-a783" primary="true" />
      </categoryLinks>
      <profiles>
        <profile name="Heroes" hidden="false" typeId="49d0-84ee-492f-492f" typeName="Unit" id="c847-e5a9-39f6-fc4a">
          <characteristics>
            <characteristic name="Wounds" typeId="aea1-39b1-ec9b-475a">5</characteristic>
            <characteristic name="Skills" typeId="1200-2470-7a16-e426">0-2</characteristic>
            <characteristic name="Notes" typeId="fb14-0b46-30b6-76a9">Max 1 Hero may be included per Formation of 5 Warriors or Marksmen in the warband (enforced: the Heroes limit grows by 1 for each Warriors or Marksmen Formation in the warband). Always fights and moves alone. Combat hand = 1 card per remaining Wound. Free bonus per Hero: 1 free Veteran Skill for any 1 Unit (or spend 1 more Honour to upgrade that free Skill to Elite) -- apply as a discount.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink id="ef2c-2876-2427-7dcc" name="No Ranged Weapons" hidden="false" targetId="184f-2267-491d-6ebb" type="rule" />
      </infoLinks>
