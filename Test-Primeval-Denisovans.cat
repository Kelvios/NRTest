  <sharedRules>
    <rule id="184f-2267-491d-6ebb" name="No Ranged Weapons" hidden="false">
      <description>Denisovans did not develop the bow, so they may not include Archers. Their throwing sticks are covered by the Long Shot Skill.</description>
    </rule>
  </sharedRules>
  <entryLinks>
