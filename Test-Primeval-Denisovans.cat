<?xml version='1.0' encoding='utf-8'?>
<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema" library="false" id="dfa4-5e10-25c9-a9ff" name="Primeval - Denisovans" gameSystemId="sys-e140-121e-9b34-0be3" gameSystemRevision="12" revision="12" battleScribeVersion="2.03" type="catalogue" authorName="TRIBAL 2nd Edition rules by Mana Press. NR data authored privately for personal use.">
  <sharedSelectionEntries>
    <selectionEntry type="upgrade" name="Agile (Veteran Skill)" hidden="false" id="2329-f51e-c90e-8853" import="true">
      <rules>
        <rule id="8528-0866-bc43-08ea" name="Agile" hidden="false">
          <description>The Unit always begins a combat round with Advantage, even if Charged. If both Units engaged in combat have this Skill, the Unit that made the Charge starts with Advantage as normal.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="9b33-a249-045b-cb37" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Fearsome (Veteran Skill)" hidden="false" id="71ee-d61e-2a78-3123" import="true">
      <rules>
        <rule id="502a-8acb-6121-11c8" name="Fearsome" hidden="false">
          <description>+1 wound damage from hits with Strike Cards when fighting units of more than one miniature. Characters with dogs attached still count as a single miniature, so they are not subject to it. (Primeval update to the core Fearsome.)</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="da98-4693-d001-ad3d" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Adept [Skilled] (Veteran Skill)" hidden="false" id="1269-95fa-63c4-0dc5" import="true">
      <rules>
        <rule id="5248-724c-b096-5e3e" name="Adept" hidden="false">
          <description>After long training with their weapon of choice, this Unit has a Preferred Weapon Bonus of +2 instead of the normal +1. Cannot be combined with Champion or Duellist.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="0038-efc8-98fd-bd34" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Skin-Changer (Veteran Skill)" hidden="false" id="4105-0d97-5daf-bda0" import="true">
      <rules>
        <rule id="d58f-fe69-8edb-4eca" name="Skin-Changer" hidden="false">
          <description>Characters only. If a wounded Skin-Changer wins an Exchange with a Panic! card, it is resolved with full combat effect.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="484c-aa7c-af13-aa40" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Throwing Weapons (Veteran Skill)" hidden="false" id="ba2b-2bfd-abc8-3189" import="true">
      <rules>
        <rule id="bcdf-a48a-6f1a-bb28" name="Throwing Weapons" hidden="false">
          <description>When this Unit Charges into close combat, flip a card: a black (Spade or Club) card causes 1 hit on the target before the Charge is resolved. Not increased by Strong.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="2c2e-8e6d-8b20-a36f" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Tough (Veteran Skill)" hidden="false" id="8841-9549-80c1-6827" import="true">
      <rules>
        <rule id="a827-720f-3b55-39d2" name="Tough" hidden="false">
          <description>Characters only. This Character begins the game with +1 Wound. This extra Wound does not increase its combat hand size.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="6556-b755-be53-3699" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Seasoned (Elite Skill)" hidden="false" id="0b62-a0b6-88e1-1e41" import="true">
      <rules>
        <rule id="bc66-9aa9-0a93-d24b" name="Seasoned" hidden="false">
          <description>This Unit may discard and redraw 2 cards from its combat hand before the first Exchange of a combat.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="f35a-8873-c21e-c7a0" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="2" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Tactician (Elite Skill)" hidden="false" id="4140-63a5-7a14-eac4" import="true">
      <rules>
        <rule id="ace8-2109-32cd-067b" name="Tactician" hidden="false">
          <description>Warlord only. Immediately after the setup phase, the player may reposition 1 enemy Hero or Formation anywhere within the opponent's setup zone. Costs 2 Honour in the Denisovan list (1 in the core rules).</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="194c-23d9-fd50-72e1" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="2" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Long Shot (Veteran Skill)" hidden="false" id="1c96-e473-6cd4-93f6" import="true">
      <rules>
        <rule id="27be-db90-633e-cbb6" name="Long Shot" hidden="false">
          <description>A unit must also have Throwing Weapons. On its activation it may make a missile attack at a target within 2 long card-lengths, as Archers do, and unlike Archers the warband DOES receive Honour for a unit destroyed. A unit may buy both Throwing Weapons and Long Shot for 2 Honour Points. (Denisovan version; differs from the core Long Shot.)</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="d1c7-608a-9abc-3736" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Ranger (Veteran Skill)" hidden="false" id="c2cb-3e50-107f-f5a2" import="true">
      <rules>
        <rule id="9c81-9036-a4fb-6fbe" name="Ranger" hidden="false">
          <description>Characters only. Not slowed to short card-lengths in Tough Going, and may Walk (1 short card-length) across Impassable terrain if it can clear it in a single Activation. (Denisovan version; differs from the core Ranger.)</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="51d1-e4d9-ffc6-976e" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Short Weapon" hidden="false" id="a779-22b2-17e9-02de" import="true">
      <rules>
        <rule id="8352-f6be-26b1-b464" name="Short Weapon" hidden="false">
          <description>Sword, axe, knife, club or similar. Gives the Preferred Weapon Bonus on Club Strike cards.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="0" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Long Weapon" hidden="false" id="467b-0110-48c1-48a7" import="true">
      <rules>
        <rule id="9d89-b5eb-413f-707e" name="Long Weapon" hidden="false">
          <description>Spear, long-axe, pike, polearm or similar. Gives the Preferred Weapon Bonus on Spade Strike cards.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="0" />
      </costs>
    </selectionEntry>
    <selectionEntry type="model" name="Chief (Warlord)" hidden="false" id="a67e-5775-1333-8cd4" import="true">
      <categoryLinks>
        <categoryLink id="21fe-7230-6d51-dfa1" name="Warlord" hidden="false" targetId="21fb-7998-9dc4-5fd0" primary="true" />
      </categoryLinks>
      <profiles>
        <profile name="Chief (Warlord)" hidden="false" typeId="49d0-84ee-492f-492f" typeName="Unit" id="e0f8-eb51-bd3c-995a">
          <characteristics>
            <characteristic name="Wounds" typeId="aea1-39b1-ec9b-475a">6</characteristic>
            <characteristic name="Skills" typeId="1200-2470-7a16-e426">0-3</characteristic>
            <characteristic name="Notes" typeId="fb14-0b46-30b6-76a9">Always fights and moves alone; never joins Heroes or Formations. Combat hand = 1 card per remaining Wound. Free bonus: 1 free Elite Skill for any 1 Unit in the warband (including itself), OR 1 free Veteran Skill for each of 2 Units -- apply this as a discount when you spend Honour on Skills.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink id="486a-ce15-3d7d-d67a" name="No Ranged Weapons" hidden="false" targetId="184f-2267-491d-6ebb" type="rule" />
      </infoLinks>
