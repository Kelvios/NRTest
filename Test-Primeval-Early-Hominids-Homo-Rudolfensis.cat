<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema" library="false" id="5865-b75a-4811-1350" name="Primeval - Early Hominids: Homo Rudolfensis" gameSystemId="sys-e140-121e-9b34-0be3" gameSystemRevision="12" revision="12" battleScribeVersion="2.03" type="catalogue" authorName="TRIBAL 2nd Edition rules by Mana Press. NR data authored privately for personal use.">
  <sharedSelectionEntries>
    <selectionEntry type="upgrade" name="Strong (Elite Skill)" hidden="false" id="2cf7-ccbe-a2c5-d5bc" import="true">
      <rules>
        <rule id="7c18-d483-224b-ac8e" name="Strong" hidden="false">
          <description>Characters only. This Character causes +1 hit when it wins a hand-to-hand Exchange with a Spade or Club Strike card.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="1427-bc33-94f9-f5de" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="2" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Adept [Skilled] (Veteran Skill)" hidden="false" id="efcc-08e1-024d-f6be" import="true">
      <rules>
        <rule id="caa5-9e37-3e6f-f6ae" name="Adept" hidden="false">
          <description>After long training with their weapon of choice, this Unit has a Preferred Weapon Bonus of +2 instead of the normal +1. Cannot be combined with Champion or Duellist.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="8e9e-cac6-b5aa-6a88" />
      </constraints>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1" />
      </costs>
    </selectionEntry>
