    <selectionEntry type="upgrade" name="Exploratores" hidden="false" id="5919-29e1-0215-f3d1" import="true">
      <categoryLinks>
        <categoryLink id="1bd6-26a4-fc0b-ab85" name="Support" hidden="false" targetId="593d-f6c4-10ed-66df" primary="true" />
      </categoryLinks>
      <rules>
        <rule id="b104-7852-cce4-8153" name="Exploratores" hidden="false">
          <description>List One. Mounted scouts that never appear on the table. Each scouts one terrain feature before the game. Maximum two.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="2" field="selections" scope="roster" shared="true" id="3073-a624-9fd0-aa32" />
      </constraints>
      <costs>
        <cost name="Support" typeId="7c9a-b7c3-373d-72a6" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Supra Numerum Leader (Support)" hidden="false" id="5e18-c3eb-ca00-7ff9" import="true">
      <categoryLinks>
        <categoryLink id="2f85-8baf-7789-cffc" name="Support" hidden="false" targetId="593d-f6c4-10ed-66df" primary="true" />
      </categoryLinks>
      <rules>
        <rule id="1b13-0068-7485-a761" name="Supra Numerum Leader (Support)" hidden="false">
          <description>List One. A leader who is not on the table and has no command initiatives. Only Status I, Status II and Supra Numerum leaders may be chosen as support.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Support" typeId="7c9a-b7c3-373d-72a6" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Musician" hidden="false" id="40d8-2dfc-94da-7d46" import="true">
      <categoryLinks>
        <categoryLink id="65a9-7cbe-f785-125c" name="Support" hidden="false" targetId="593d-f6c4-10ed-66df" primary="true" />
      </categoryLinks>
      <rules>
        <rule id="8317-4403-94c1-f903" name="Musician" hidden="false">
          <description>List Two. Attached to the force commander to double his Command Range. Maximum one.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="0e40-16ac-0d78-c5e7" />
      </constraints>
      <costs>
        <cost name="Support" typeId="7c9a-b7c3-373d-72a6" value="2" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Mule Train" hidden="false" id="1798-4003-9f3d-9070" import="true">
      <categoryLinks>
        <categoryLink id="8622-4b91-a466-ef99" name="Support" hidden="false" targetId="593d-f6c4-10ed-66df" primary="true" />
      </categoryLinks>
      <rules>
        <rule id="3646-8e29-6e24-1f64" name="Mule Train" hidden="false">
          <description>List Two. Limited supplies; Groups out of ammunition can resupply from it. Maximum two.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="2" field="selections" scope="roster" shared="true" id="50be-3095-50a2-30fd" />
      </constraints>
      <costs>
        <cost name="Support" typeId="7c9a-b7c3-373d-72a6" value="2" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Cratis" hidden="false" id="3b4b-905e-7c36-803c" import="true">
      <categoryLinks>
        <categoryLink id="b485-9815-eb52-385f" name="Support" hidden="false" targetId="593d-f6c4-10ed-66df" primary="true" />
      </categoryLinks>
      <rules>
        <rule id="85c8-3fea-6120-918c" name="Cratis" hidden="false">
          <description>List Two. One bundle of Cratis; any number may be chosen. See the rulebook (page 70).</description>
        </rule>
      </rules>
      <costs>
        <cost name="Support" typeId="7c9a-b7c3-373d-72a6" value="2" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Lilia and Tribuli" hidden="false" id="0a0d-72f7-b39e-0be7" import="true">
      <categoryLinks>
        <categoryLink id="28c1-adf0-b2fc-bba6" name="Support" hidden="false" targetId="593d-f6c4-10ed-66df" primary="true" />
      </categoryLinks>
      <rules>
        <rule id="e9cc-2eef-5d91-0ea7" name="Lilia and Tribuli" hidden="false">
          <description>List Two. One 12 inch section of defences is covered by Lilia and Tribuli; any number may be chosen.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Support" typeId="7c9a-b7c3-373d-72a6" value="2" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Status I Leader (Support)" hidden="false" id="3ecb-2e63-1fdf-3deb" import="true">
      <categoryLinks>
        <categoryLink id="1438-9bec-8fdb-b82d" name="Support" hidden="false" targetId="593d-f6c4-10ed-66df" primary="true" />
      </categoryLinks>
      <rules>
        <rule id="220e-c0ca-0c21-0e0d" name="Status I Leader (Support)" hidden="false">
          <description>List Three. A named Status I leader taken as support.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Support" typeId="7c9a-b7c3-373d-72a6" value="3" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Capsarius" hidden="false" id="0a05-e78f-9814-caa3" import="true">
      <categoryLinks>
        <categoryLink id="3298-c90b-e9ae-e91b" name="Support" hidden="false" targetId="593d-f6c4-10ed-66df" primary="true" />
      </categoryLinks>
      <rules>
        <rule id="11cb-0c00-48ae-53c1" name="Capsarius" hidden="false">
          <description>List Three. A medic who can restore one Status level to a wounded leader while attending him. Maximum one.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="a11b-e4f5-67e1-4203" />
      </constraints>
      <costs>
        <cost name="Support" typeId="7c9a-b7c3-373d-72a6" value="3" />
      </costs>
    </selectionEntry>
    <selectionEntry type="unit" name="Engineer Group with Cart" hidden="false" id="d5df-53a3-e1c8-c4d4" import="true">
      <categoryLinks>
        <categoryLink id="d12f-84f3-426d-c4cd" name="Support" hidden="false" targetId="593d-f6c4-10ed-66df" primary="true" />
