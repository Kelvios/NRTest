      <profiles>
        <profile name="Roman Engineers" hidden="false" typeId="8ffd-aeee-ace4-24ad" typeName="Group" id="7712-f6ed-c96c-d054">
          <characteristics>
            <characteristic name="Type" typeId="8399-5229-8ab6-30be">Inferior Warriors</characteristic>
            <characteristic name="Strength" typeId="1e86-00d5-78b8-cebe">6</characteristic>
            <characteristic name="Armour" typeId="1ffe-0648-62ea-d789">Medium</characteristic>
            <characteristic name="Weapons" typeId="6c11-dcad-c329-860b">Mixed</characteristic>
            <characteristic name="Aggressive Attack" typeId="7e26-4e3f-43fb-234a">3</characteristic>
            <characteristic name="Step Out" typeId="33bf-1756-6775-d9ed">3</characteristic>
            <characteristic name="Characteristics" typeId="462f-1611-3539-7732">Drilled</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="ef22-f7c9-5f13-ab6a" name="Engineer Group with Cart" hidden="false">
          <description>List Four. Six figures with a cart carrying a battering ram and tools. They do not attack. They may add 6 inches of Improvised Defences at no cost. Maximum one Group.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="0a4b-e1c1-12ac-b008" />
