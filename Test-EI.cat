      </categoryLinks>
      <rules>
        <rule id="4bec-ac4a-a446-ff1c" name="Improvised Defences" hidden="false">
          <description>List Twelve. One 12 inch section placed within 12 inches of the Deployment Zone or friendly Ambush Points. Maximum one.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="6e93-02e4-0d7b-01cd" />
      </constraints>
      <costs>
        <cost name="Support" typeId="7c9a-b7c3-373d-72a6" value="12" />
      </costs>
    </selectionEntry>
