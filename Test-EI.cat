        <categoryLink id="5498-3aea-1b9d-20c7" name="Support" hidden="false" targetId="593d-f6c4-10ed-66df" primary="true" />
      </categoryLinks>
      <rules>
        <rule id="c7cf-e62e-fbc7-8984" name="Status II Leader (Support)" hidden="false">
          <description>List Six (added by erratum). A named Status II leader taken as support. He is an Optio if with Regular Drilled Troops.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Support" typeId="7c9a-b7c3-373d-72a6" value="6" />
      </costs>
