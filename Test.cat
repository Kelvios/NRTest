      <rules>
        <rule id="b673-fc72-d80f-91c0" name="Improvised Defences" hidden="false">
          <description>List Twelve. One 12 inch section placed within 12 inches of the Deployment Zone or friendly Ambush Points. Maximum one.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="f566-e763-e028-52d7" />
      </constraints>
      <costs>
        <cost name="Support" typeId="7c9a-b7c3-373d-72a6" value="12" />
