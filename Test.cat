            <characteristic name="Characteristics" typeId="462f-1611-3539-7732">Drilled</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="594d-4907-dc5e-d54e" name="Engineer Group with Cart" hidden="false">
          <description>List Four. Six figures with a cart carrying a battering ram and tools. They do not attack. They may add 6 inches of Improvised Defences at no cost. Maximum one Group.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="16d1-4694-3046-3db3" />
