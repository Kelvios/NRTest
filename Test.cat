            <characteristic name="Strength" typeId="1e86-00d5-78b8-cebe">5</characteristic>
            <characteristic name="Armour" typeId="1ffe-0648-62ea-d789">Medium</characteristic>
            <characteristic name="Weapons" typeId="6c11-dcad-c329-860b">Scorpion</characteristic>
            <characteristic name="Aggressive Attack" typeId="7e26-4e3f-43fb-234a">-</characteristic>
            <characteristic name="Step Out" typeId="33bf-1756-6775-d9ed">-</characteristic>
            <characteristic name="Characteristics" typeId="462f-1611-3539-7732">Supra Numerum</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <costs>
        <cost name="Points" typeId="e89e-26b3-ba84-d897" value="10" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Exploratores" hidden="false" id="b9c5-0cc8-c6d8-04d1" import="true">
      <categoryLinks>
        <categoryLink id="b4b3-659a-da05-4548" name="Support" hidden="false" targetId="593d-f6c4-10ed-66df" primary="true" />
      </categoryLinks>
      <rules>
        <rule id="6d17-2359-e148-66df" name="Exploratores" hidden="false">
          <description>List One. Mounted scouts that never appear on the table. Each scouts one terrain feature before the game. Maximum two.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="2" field="selections" scope="roster" shared="true" id="8bcb-69f2-a663-226e" />
      </constraints>
      <costs>
        <cost name="Support" typeId="7c9a-b7c3-373d-72a6" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Supra Numerum Leader (Support)" hidden="false" id="13ca-fd33-868c-e95b" import="true">
      <categoryLinks>
        <categoryLink id="6fc1-f8f3-ce16-bdfd" name="Support" hidden="false" targetId="593d-f6c4-10ed-66df" primary="true" />
      </categoryLinks>
      <rules>
        <rule id="1234-61a9-4eef-e19f" name="Supra Numerum Leader (Support)" hidden="false">
          <description>List One. A leader who is not on the table and has no command initiatives. Only Status I, Status II and Supra Numerum leaders may be chosen as support.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Support" typeId="7c9a-b7c3-373d-72a6" value="1" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Musician" hidden="false" id="900d-ff10-e9aa-b551" import="true">
      <categoryLinks>
        <categoryLink id="d1a6-d6b8-f3c3-f27e" name="Support" hidden="false" targetId="593d-f6c4-10ed-66df" primary="true" />
      </categoryLinks>
      <rules>
        <rule id="c757-2671-b32c-9766" name="Musician" hidden="false">
          <description>List Two. Attached to the force commander to double his Command Range. Maximum one.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="b178-7604-0aff-6eaf" />
      </constraints>
      <costs>
        <cost name="Support" typeId="7c9a-b7c3-373d-72a6" value="2" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Mule Train" hidden="false" id="bc60-113b-4d4a-ef11" import="true">
      <categoryLinks>
        <categoryLink id="a2e2-d89e-3a82-f7ab" name="Support" hidden="false" targetId="593d-f6c4-10ed-66df" primary="true" />
      </categoryLinks>
      <rules>
        <rule id="7822-26e9-d10a-b98f" name="Mule Train" hidden="false">
          <description>List Two. Limited supplies; Groups out of ammunition can resupply from it. Maximum two.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="2" field="selections" scope="roster" shared="true" id="b085-cc7b-1f37-5a31" />
      </constraints>
      <costs>
        <cost name="Support" typeId="7c9a-b7c3-373d-72a6" value="2" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Cratis" hidden="false" id="b65b-02de-4c42-e843" import="true">
      <categoryLinks>
        <categoryLink id="906e-2119-2708-57b8" name="Support" hidden="false" targetId="593d-f6c4-10ed-66df" primary="true" />
      </categoryLinks>
      <rules>
        <rule id="6909-ebda-e56e-9bcb" name="Cratis" hidden="false">
          <description>List Two. One bundle of Cratis; any number may be chosen. See the rulebook (page 70).</description>
        </rule>
      </rules>
      <costs>
        <cost name="Support" typeId="7c9a-b7c3-373d-72a6" value="2" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Lilia and Tribuli" hidden="false" id="d816-47c0-8746-aaf0" import="true">
      <categoryLinks>
        <categoryLink id="dbae-ed92-2e58-e3f3" name="Support" hidden="false" targetId="593d-f6c4-10ed-66df" primary="true" />
      </categoryLinks>
      <rules>
        <rule id="7d0c-1f45-1e68-8188" name="Lilia and Tribuli" hidden="false">
          <description>List Two. One 12 inch section of defences is covered by Lilia and Tribuli; any number may be chosen.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Support" typeId="7c9a-b7c3-373d-72a6" value="2" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Status I Leader (Support)" hidden="false" id="6b20-b5a7-57cc-ba5f" import="true">
      <categoryLinks>
        <categoryLink id="9b35-bf18-a7b7-2fc4" name="Support" hidden="false" targetId="593d-f6c4-10ed-66df" primary="true" />
      </categoryLinks>
      <rules>
        <rule id="af70-bf6c-1d9a-2da8" name="Status I Leader (Support)" hidden="false">
          <description>List Three. A named Status I leader taken as support.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Support" typeId="7c9a-b7c3-373d-72a6" value="3" />
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Capsarius" hidden="false" id="5a2a-13e7-9db7-2e39" import="true">
      <categoryLinks>
        <categoryLink id="1b30-2db8-c7ad-ec8b" name="Support" hidden="false" targetId="593d-f6c4-10ed-66df" primary="true" />
      </categoryLinks>
      <rules>
        <rule id="e725-1de8-2830-f85e" name="Capsarius" hidden="false">
          <description>List Three. A medic who can restore one Status level to a wounded leader while attending him. Maximum one.</description>
        </rule>
      </rules>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="97bf-737a-dd97-68f2" />
      </constraints>
      <costs>
        <cost name="Support" typeId="7c9a-b7c3-373d-72a6" value="3" />
      </costs>
    </selectionEntry>
    <selectionEntry type="unit" name="Engineer Group with Cart" hidden="false" id="33d2-5633-9195-8c24" import="true">
      <categoryLinks>
        <categoryLink id="f059-c2d5-9f10-3bad" name="Support" hidden="false" targetId="593d-f6c4-10ed-66df" primary="true" />
      </categoryLinks>
      <profiles>
        <profile name="Roman Engineers" hidden="false" typeId="8ffd-aeee-ace4-24ad" typeName="Group" id="e1fa-cac6-4100-d3c1">
          <characteristics>
            <characteristic name="Type" typeId="8399-5229-8ab6-30be">Inferior Warriors</characteristic>
